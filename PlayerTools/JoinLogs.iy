--[[
    JoinLogs.iy — Infinite Yield plugin
    Better player join/leave logger than stock IY jlogs.

    - Joins AND leaves (stock IY only logs joins)
    - DisplayName + @Username + UserId + account age
    - Friend / new-account highlighting
    - Floating JL chip + scrollable panel (drag either)
    - Click a row to copy Username / UserId
    - Optional toast notifications
    - Appends to PlayerTools/joinlogs.txt
    - Optional Discord webhook
    - 1m auto-block: timer on join, cancel on leave, focus client + instant mouse click Block, hop F1→F11

    Install: workspace/JoinLogs.iy → IY Plugins → Add → JoinLogs
    Commands: jlgui | jlon | jloff | jlclear | jlsave | jlnotify | jlauto | jlwebhook [url]
]]

local Players = game:GetService('Players')
local HttpService = game:GetService('HttpService')
local UserInputService = game:GetService('UserInputService')
local TeleportService = game:GetService('TeleportService')
local GuiService = game:GetService('GuiService')
local StarterGui = game:GetService('StarterGui')
local VirtualInputManager = game:GetService('VirtualInputManager')
local LocalPlayer = Players.LocalPlayer
	or Players:GetPropertyChangedSignal('LocalPlayer'):Wait()
	or Players.LocalPlayer

local GENV = 'SB2JoinLogs'
local GENV_GUI = 'SB2JoinLogsGui'
local GENV_CONNS = 'SB2JoinLogsConns'
local GENV_STOP = 'SB2JoinLogsStop'

local SAVE_PATH = 'PlayerTools/joinlogs.txt'
local HOP_PATH = 'PlayerTools/autoblock_hop.json'
local MAX_ENTRIES = 300
local NEW_ACCOUNT_DAYS = 14
local AUTO_BLOCK_WAIT = 60
local ACTION_DELAY = 0.5
local F1_PLACE = 542351431
local F11_PLACE = 5287433115
