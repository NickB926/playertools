	autoBar.Position = UDim2.fromOffset(10, 86)
	autoBar.Parent = frame
	local autoBtn = mkBtn(
		autoBar,
		state.autoBlock and '1m ON' or '1m',
		UDim2.fromOffset(64, 26),
		UDim2.fromOffset(0, 0),
		state.autoBlock and Color3.fromRGB(110, 55, 55) or Color3.fromRGB(40, 44, 52)
	)
	local autoLabel = Instance.new('TextLabel')
	autoLabel.BackgroundTransparency = 1
	autoLabel.Size = UDim2.new(1, -72, 1, 0)
	autoLabel.Position = UDim2.fromOffset(72, 0)
	autoLabel.Font = Enum.Font.Gotham
	autoLabel.TextSize = 12
	autoLabel.TextXAlignment = Enum.TextXAlignment.Left
	autoLabel.TextColor3 = Color3.fromRGB(180, 150, 150)
	autoLabel.TextTruncate = Enum.TextTruncate.AtEnd
	autoLabel.Text = state.autoBlock and 'watching' or 'off'
	autoLabel.Parent = autoBar

	local search = Instance.new('TextBox')
	search.Name = 'Search'
	search.Size = UDim2.new(1, -20, 0, 28)
	search.Position = UDim2.fromOffset(10, 118)
	search.BackgroundColor3 = Color3.fromRGB(28, 31, 38)
	search.BorderSizePixel = 0
	search.ClearTextOnFocus = false
	search.Font = Enum.Font.Gotham
	search.TextSize = 13
	search.TextColor3 = Color3.fromRGB(230, 232, 240)
	search.PlaceholderColor3 = Color3.fromRGB(110, 118, 130)
	search.PlaceholderText = 'search name / id…'
	search.Text = tostring(state.search or '')
	search.TextXAlignment = Enum.TextXAlignment.Left
	search.Parent = frame
	Instance.new('UICorner', search).CornerRadius = UDim.new(0, 6)
	local sPad = Instance.new('UIPadding')
	sPad.PaddingLeft = UDim.new(0, 10)
	sPad.Parent = search

	local list = Instance.new('ScrollingFrame')
	list.Name = 'List'
	list.Size = UDim2.new(1, -20, 1, -178)
	list.Position = UDim2.fromOffset(10, 154)
	list.BackgroundColor3 = Color3.fromRGB(28, 31, 38)
	list.BorderSizePixel = 0
	list.ScrollBarThickness = 5
	list.CanvasSize = UDim2.new(0, 0, 0, 0)
	list.AutomaticCanvasSize = Enum.AutomaticSize.Y
	list.Parent = frame
	Instance.new('UICorner', list).CornerRadius = UDim.new(0, 8)
	local layout = Instance.new('UIListLayout')
	layout.Padding = UDim.new(0, 5)
	layout.SortOrder = Enum.SortOrder.LayoutOrder
	layout.Parent = list
	local pad = Instance.new('UIPadding')
	pad.PaddingTop = UDim.new(0, 6)
	pad.PaddingBottom = UDim.new(0, 6)
	pad.PaddingLeft = UDim.new(0, 6)
	pad.PaddingRight = UDim.new(0, 6)
	pad.Parent = list

	local function paintFilter()
		local f = state.filter
		filterAll.BackgroundColor3 = f == 'all' and Color3.fromRGB(55, 85, 120) or Color3.fromRGB(40, 44, 52)
		filterJoin.BackgroundColor3 = f == 'join' and Color3.fromRGB(45, 95, 65) or Color3.fromRGB(40, 44, 52)
		filterLeave.BackgroundColor3 = f == 'leave' and Color3.fromRGB(110, 55, 55) or Color3.fromRGB(40, 44, 52)
	end

	local function paintToggles()
		toggleBtn.Text = state.enabled and 'ON' or 'OFF'
		toggleBtn.BackgroundColor3 = state.enabled and Color3.fromRGB(40, 90, 60) or Color3.fromRGB(90, 45, 45)
		notifyBtn.Text = state.notify and 'Ntf' or 'Mute'
		autoBtn.Text = state.autoBlock and '1m ON' or '1m'
		autoBtn.BackgroundColor3 = state.autoBlock and Color3.fromRGB(110, 55, 55) or Color3.fromRGB(40, 44, 52)
		autoLabel.Text = autoStatusText
		autoLabel.TextColor3 = state.autoBlock and Color3.fromRGB(220, 170, 170) or Color3.fromRGB(140, 148, 160)
		if type(getgenv().SB2SetPillText) == 'function' then
			getgenv().SB2SetPillText('JL', state.enabled and 'JL' or 'JL·')
		end
		local dock = getgenv().SB2PillDock
		local pill = dock and dock.pills and dock.pills.JL
		if pill then
			pill.TextColor3 = state.enabled and Color3.fromRGB(170, 210, 255) or Color3.fromRGB(140, 140, 150)
		end
	end
	paintAuto = paintToggles

	refreshGui = function()
		for _, child in ipairs(list:GetChildren()) do
			if child:IsA('GuiObject') then
				child:Destroy()
			end
		end
		paintFilter()
		paintToggles()
		title.Text = ('Join Logs  ·  %d'):format(#state.entries)
		local rows = filteredEntries()
		if #rows == 0 then
			local empty = Instance.new('TextLabel')
			empty.Name = 'Empty'
			empty.BackgroundTransparency = 1
			empty.Size = UDim2.new(1, 0, 0, 40)
			empty.Font = Enum.Font.Gotham
			empty.TextSize = 13
			empty.TextColor3 = Color3.fromRGB(120, 128, 140)
			empty.Text = state.enabled and 'no entries yet' or 'logging paused (jlon to resume)'
			empty.Parent = list
			return
		end
		for i, e in ipairs(rows) do
			local kindColor = Color3.fromRGB(152, 195, 121)
			local kindText = 'JOIN'
			if e.kind == 'leave' then
				kindColor = Color3.fromRGB(224, 108, 117)
				kindText = 'LEFT'
			elseif e.kind == 'here' then
				kindColor = Color3.fromRGB(120, 130, 150)
				kindText = 'HERE'
			end
			if e.friend then
				kindColor = Color3.fromRGB(97, 175, 239)
			elseif e.newAccount and e.kind ~= 'here' then
				kindColor = Color3.fromRGB(229, 192, 123)
			end

			local row = Instance.new('TextButton')
			row.Name = 'Row'
			row.LayoutOrder = i
			row.Size = UDim2.new(1, 0, 0, 52)
			row.BackgroundColor3 = Color3.fromRGB(34, 38, 46)
			row.BorderSizePixel = 0
			row.AutoButtonColor = true
			row.Text = ''
			row.Parent = list
			Instance.new('UICorner', row).CornerRadius = UDim.new(0, 6)

			local accent = Instance.new('Frame')
			accent.Size = UDim2.new(0, 3, 1, -10)
			accent.Position = UDim2.fromOffset(4, 5)
			accent.BackgroundColor3 = kindColor
			accent.BorderSizePixel = 0
			accent.Parent = row
			Instance.new('UICorner', accent).CornerRadius = UDim.new(0, 2)

			local line1 = Instance.new('TextLabel')
			line1.BackgroundTransparency = 1
			line1.Size = UDim2.new(1, -128, 0, 22)
			line1.Position = UDim2.fromOffset(14, 6)
			line1.Font = Enum.Font.GothamBold
			line1.TextSize = 13
			line1.TextXAlignment = Enum.TextXAlignment.Left
			line1.TextColor3 = Color3.fromRGB(235, 238, 245)
			line1.TextTruncate = Enum.TextTruncate.AtEnd
			if e.displayName ~= e.username then
				line1.Text = ('%s  (@%s)'):format(e.displayName, e.username)
			else
				line1.Text = e.username
			end
			line1.Parent = row

			local line2 = Instance.new('TextLabel')
			line2.BackgroundTransparency = 1
			line2.Size = UDim2.new(1, -128, 0, 18)
			line2.Position = UDim2.fromOffset(14, 28)
			line2.Font = Enum.Font.Gotham
			line2.TextSize = 11
			line2.TextXAlignment = Enum.TextXAlignment.Left
			line2.TextColor3 = Color3.fromRGB(140, 148, 160)
			local flags = {}
			if e.friend then
				flags[#flags + 1] = 'friend'
			end
			if e.newAccount then
				flags[#flags + 1] = 'new'
			end
			line2.Text = ('%s · id %s · age %sd%s'):format(
				stamp(e.time),
				tostring(e.userId),
				tostring(e.accountAge or '?'),
				#flags > 0 and (' · ' .. table.concat(flags, ', ')) or ''
			)
			line2.Parent = row

			local badge = Instance.new('TextLabel')
			badge.BackgroundTransparency = 1
			badge.Size = UDim2.fromOffset(48, 20)
			badge.Position = UDim2.new(1, -54, 0, 6)
			badge.Font = Enum.Font.GothamBold
			badge.TextSize = 11
			badge.TextColor3 = kindColor
			badge.Text = kindText
			badge.Parent = row

			local blockBtn = mkBtn(row, 'Block', UDim2.fromOffset(52, 20), UDim2.new(1, -110, 0, 6), Color3.fromRGB(110, 50, 55))
			blockBtn.TextSize = 11
			blockBtn.ZIndex = 3
			blockBtn.Active = true
			blockBtn.AutoButtonColor = true
			track(blockBtn.MouseButton1Click:Connect(function()
				row:SetAttribute('SkipCopy', true)
				promptBlockPlayer(e)
				task.defer(function()
					if row.Parent then
						row:SetAttribute('SkipCopy', false)
					end
				end)
			end))

			track(row.MouseButton1Click:Connect(function()
				if row:GetAttribute('SkipCopy') then
					return
				end
				local payload = ('%s\t%s'):format(e.username, tostring(e.userId))
				if setClipboard(payload) then
					say(('copied %s'):format(payload))
				else
					say(payload)
				end
			end))
			track(row.MouseButton2Click:Connect(function()
				if setClipboard(tostring(e.userId)) then
					say('copied userId ' .. tostring(e.userId))
				end
			end))
		end
	end

	track(filterAll.MouseButton1Click:Connect(function()
		state.filter = 'all'
		refreshGui()
	end))
	track(filterJoin.MouseButton1Click:Connect(function()
		state.filter = 'join'
		refreshGui()
	end))
	track(filterLeave.MouseButton1Click:Connect(function()
		state.filter = 'leave'
		refreshGui()
	end))
	track(toggleBtn.MouseButton1Click:Connect(function()
		state.enabled = not state.enabled
		paintToggles()
		say(state.enabled and 'logging on' or 'logging off')
	end))
	track(notifyBtn.MouseButton1Click:Connect(function()
		state.notify = not state.notify
		paintToggles()
		say(state.notify and 'toasts on' or 'toasts off')
	end))
	track(autoBtn.MouseButton1Click:Connect(function()
		setAutoBlockEnabled(not state.autoBlock, false)
		paintToggles()
	end))
	track(clearBtn.MouseButton1Click:Connect(function()
		state.entries = {}
		refreshGui()
		say('cleared session log')
	end))
	track(saveBtn.MouseButton1Click:Connect(function()
		ensureLogFolder()
		local lines = { '-- JoinLogs dump ' .. stampFull() }
		for _, e in ipairs(state.entries) do
			lines[#lines + 1] = ('[%s] %s %s (@%s) id=%s age=%s'):format(
				stampFull(e.time),
				string.upper(e.kind),
				e.displayName,
				e.username,
				tostring(e.userId),
				tostring(e.accountAge or '?')
			)
		end
		local path = ('PlayerTools/joinlogs_dump_%s.txt'):format(os.time())
		if type(writefile) == 'function' then
			pcall(writefile, path, table.concat(lines, '\n'))
			say('saved ' .. path)
		else
			say('writefile unavailable')
		end
	end))
	track(search:GetPropertyChangedSignal('Text'):Connect(function()
		state.search = search.Text
		refreshGui()
	end))

	refreshGui()
	setPanelOpen(false)
	return gui
end

local function ensureGui()
	local gui = getgenv()[GENV_GUI]
	if gui and gui.Parent then
		pcall(registerJlPill)
		return gui
	end
	return buildGui()
end

getgenv().SB2JoinLogsToggleGui = function()
	ensureGui()
	local open = togglePanel()
	if open and refreshGui then
		refreshGui()
	end
	return open
end

local function hookPlayers()
	track(Players.PlayerAdded:Connect(function(plr)
		if plr == LocalPlayer then
			return
		end
		-- IsFriendsWith can yield; defer so join isn't dropped.
		task.defer(function()
			pushEntry('join', plr)
			startAutoTimer(plr)
		end)
	end))
	track(Players.PlayerRemoving:Connect(function(plr)
		if plr == LocalPlayer then
			return
		end
		cancelAutoTimer(plr.UserId)
		-- Capture meta before the player instance is gone.
		local meta = playerMeta(plr)
		pushEntry('leave', meta)
		if state.autoBlock and not autoBusy and not soonestTimer() then
			setAutoStatus('watching')
		end
	end))
end

local function seedPresent()
	-- Only seed once per server job so reloads don't spam HERE.
	local key = 'seeded_' .. tostring(game.JobId)
	if state[key] then
		return
	end
	state[key] = true
	for _, plr in ipairs(Players:GetPlayers()) do
		if plr ~= LocalPlayer then
			pushEntry('here', plr, { force = true })
		end
	end
end

local function stopPlugin()
	destroyGui()
	getgenv()[GENV_STOP] = nil
	say('stopped')
end

getgenv()[GENV_STOP] = stopPlugin

-- Boot
ensureGui()
setPanelOpen(false)
hookPlayers()
task.defer(seedPresent)
task.defer(function()
	-- AutoBlock.iy owns join-watch when installed — JoinLogs only mirrors status.
	if getgenv().SB2AutoBlockIyOwner == true then
		state.autoBlock = false
		cancelAllAutoTimers()
		local iyOn = getgenv().SB2GetAutoBlock and getgenv().SB2GetAutoBlock() == true
		setAutoStatus(iyOn and 'IY owns auto-block' or 'off (IY)')
		-- #region agent log
		pcall(function()
			local payload = game:GetService('HttpService'):JSONEncode({
				sessionId = '7e9135',
				hypothesisId = 'JL1',
				location = 'JoinLogs.iy:boot',
				message = 'IY owns — JL timers forced off',
				data = { iyOn = iyOn },
				timestamp = os.time() * 1000,
			})
			if type(appendfile) == 'function' then
				pcall(appendfile, 'PlayerTools/debug-7e9135.log', payload .. '\n')
			end
		end)
		-- #endregion
		if refreshGui then
			refreshGui()
		end
		return
	end
	-- Prefer PlayerTools profile file over stale JoinLogs layout.
	local fileOn = false
	pcall(function()
		if type(isfile) == 'function' and type(readfile) == 'function' and isfile('PlayerTools/autoblock') then
			fileOn = tostring(readfile('PlayerTools/autoblock')) == 'true'
		end
	end)
	local toggleOn = false
	pcall(function()
		local t = Toggles and Toggles.AutoBlockJoin
		toggleOn = type(t) == 'table' and t.Value == true
	end)
	-- Explicit false when neither source wants it (do not keep sticky genv true).
	state.autoBlock = fileOn or toggleOn
	if state.autoBlock then
		setAutoStatus('watching')
		armAutoTimersForPresent()
	else
		cancelAllAutoTimers()
		setAutoStatus('off')
		-- Do not clear SB2AutoBlockWanted / hop — PlayerTools owns those across reloads.
	end
	local hop = readHopState() or getgenv().SB2AutoBlockHop
	if type(hop) == 'table' and hop.active == true then
		local pid = game.PlaceId
		if pid ~= F1_PLACE and pid ~= F11_PLACE then
			writeHopState({
				active = false,
				phase = 'off',
				t = os.time(),
			})
			getgenv().SB2AutoBlockHopping = nil
		end
	end
	if refreshGui then
		refreshGui()
	end
end)
task.spawn(function()
	for _ = 1, 40 do
		if getgenv().SB2AutoBlockIyOwner == true then
			state.autoBlock = false
			cancelAllAutoTimers()
			local iyOn = getgenv().SB2GetAutoBlock and getgenv().SB2GetAutoBlock() == true
			setAutoStatus(iyOn and 'IY owns auto-block' or 'off (IY)')
			if refreshGui then
				refreshGui()
			end
			return
		end
		local t = Toggles and Toggles.AutoBlockJoin
		if type(t) == 'table' and t.Value ~= nil then
			-- Follow PlayerTools toggle only — never push a stale false into the profile toggle.
			state.autoBlock = t.Value == true
			if state.autoBlock then
				setAutoStatus('watching')
			else
				cancelAllAutoTimers()
				setAutoStatus('off')
			end
			if refreshGui then
				refreshGui()
			end
			return
		end
		task.wait(0.25)
	end
end)
say(state.enabled and 'active — JL chip top-right' or 'loaded (paused) — jlon to enable')

local Plugin = {
	['PluginName'] = 'JoinLogs',
	['PluginDescription'] = 'Better join/leave logs — display names, age, friends, file + webhook',
	['Commands'] = {
		['jlgui'] = {
			['ListName'] = 'jlgui / betterjlogs',
			['Description'] = 'Toggle JoinLogs panel (or click the JL chip)',
			['Aliases'] = { 'betterjlogs', 'bjl', 'jlpanel' },
			['Function'] = function()
				ensureGui()
				if togglePanel() then
					say('panel open')
				else
					say('panel closed')
				end
			end,
		},
		['jlon'] = {
			['ListName'] = 'jlon',
			['Description'] = 'Enable join/leave logging',
			['Aliases'] = { 'jlenable' },
			['Function'] = function()
				state.enabled = true
				ensureGui()
				if refreshGui then
					refreshGui()
				end
				say('logging on')
			end,
		},
		['jloff'] = {
			['ListName'] = 'jloff',
			['Description'] = 'Pause join/leave logging (keeps history)',
			['Aliases'] = { 'jldisable' },
			['Function'] = function()
				state.enabled = false
				if refreshGui then
					refreshGui()
				end
				say('logging off')
			end,
		},
		['jlclear'] = {
			['ListName'] = 'jlclear',
			['Description'] = 'Clear in-memory join log for this session',
			['Aliases'] = { 'jlwipe' },
			['Function'] = function()
				state.entries = {}
				if refreshGui then
					refreshGui()
				end
				say('cleared')
			end,
		},
		['jlsave'] = {
			['ListName'] = 'jlsave',
			['Description'] = 'Dump current session log to PlayerTools/joinlogs_dump_*.txt',
			['Aliases'] = { 'jldump' },
			['Function'] = function()
				ensureGui()
				ensureLogFolder()
				local lines = { '-- JoinLogs dump ' .. stampFull() }
				for _, e in ipairs(state.entries) do
					lines[#lines + 1] = ('[%s] %s %s (@%s) id=%s age=%s'):format(
						stampFull(e.time),
						string.upper(e.kind),
						e.displayName,
						e.username,
						tostring(e.userId),
						tostring(e.accountAge or '?')
					)
				end
				local path = ('PlayerTools/joinlogs_dump_%s.txt'):format(os.time())
				if type(writefile) == 'function' then
					pcall(writefile, path, table.concat(lines, '\n'))
					say('saved ' .. path)
				else
					say('writefile unavailable — live appends also need writefile/appendfile')
				end
			end,
		},
		['jlnotify'] = {
			['ListName'] = 'jlnotify',
			['Description'] = 'Toggle toast notifications on join/leave',
			['Aliases'] = { 'jltoasts' },
			['Function'] = function()
				state.notify = not state.notify
				if refreshGui then
					refreshGui()
				end
				say(state.notify and 'toasts on' or 'toasts off')
			end,
		},
		['jlauto'] = {
			['ListName'] = 'jlauto',
			['Description'] = 'Toggle 1-minute auto-block + F1→F11 hop',
			['Aliases'] = { 'jlblock', 'autoblock' },
			['Function'] = function()
				setAutoBlockEnabled(not state.autoBlock, false)
				ensureGui()
				if refreshGui then
					refreshGui()
				end
			end,
		},
		['jlwebhook'] = {
			['ListName'] = 'jlwebhook [url]',
			['Description'] = 'Set Discord webhook for joins/leaves (empty to clear)',
			['Aliases'] = { 'jlhook' },
			['Function'] = function(args)
				local url = args and table.concat(args, ' ') or ''
				url = url:gsub('^%s+', ''):gsub('%s+$', '')
				state.webhook = url
				if url == '' then
					say('webhook cleared')
				else
					say('webhook set')
				end
			end,
		},
		['joinlogs'] = {
			['ListName'] = 'joinlogs / jlogs',
			['Description'] = 'Open better JoinLogs (replaces stock IY feel)',
			['Aliases'] = { 'jlogs' },
			['Function'] = function()
				ensureGui()
				setPanelOpen(true)
				if refreshGui then
					refreshGui()
				end
				say('JoinLogs panel open')
			end,
		},
	},
}

return Plugin
