	local filterJoin = mkBtn(toolbar, 'Join', UDim2.fromOffset(52, 26), UDim2.fromOffset(56, 0))
	local filterLeave = mkBtn(toolbar, 'Leave', UDim2.fromOffset(58, 26), UDim2.fromOffset(112, 0))
	local toggleBtn = mkBtn(toolbar, state.enabled and 'ON' or 'OFF', UDim2.fromOffset(44, 26), UDim2.fromOffset(176, 0), state.enabled and Color3.fromRGB(40, 90, 60) or Color3.fromRGB(90, 45, 45))
	local notifyBtn = mkBtn(toolbar, state.notify and 'Ntf' or 'Mute', UDim2.fromOffset(44, 26), UDim2.fromOffset(224, 0))
	local clearBtn = mkBtn(toolbar, 'Clr', UDim2.fromOffset(36, 26), UDim2.fromOffset(272, 0), Color3.fromRGB(70, 50, 50))
	local saveBtn = mkBtn(toolbar, 'Save', UDim2.fromOffset(40, 26), UDim2.new(1, -40, 0, 0), Color3.fromRGB(45, 70, 95))

	local autoBar = Instance.new('Frame')
	autoBar.Name = 'AutoBar'
	autoBar.BackgroundTransparency = 1
