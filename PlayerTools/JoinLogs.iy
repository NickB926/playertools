local function isOwnAlt(plr)
	if type(getgenv().SB2IsOwnAlt) == 'function' and plr then
		local ok, result = pcall(getgenv().SB2IsOwnAlt, plr)
		if ok then
			return result == true
		end
	end
	if not plr then
		return false
	end
	local uid = tonumber(plr.UserId)
	if uid and OWN_ALT_USERIDS[uid] then
		return true
	end
	local extras = rawget(getgenv(), 'SB2OwnAltUserIds')
	if uid and type(extras) == 'table' and extras[uid] == true then
		return true
	end
	local name = string.lower(tostring(plr.Name or ''))
	local stubId = name:match('^roblox_user_(%d+)$')
	local stubUid = stubId and tonumber(stubId)
	if stubUid and (OWN_ALT_USERIDS[stubUid] or (type(extras) == 'table' and extras[stubUid] == true)) then
		return true
	end
	return false
end

-- Stop previous instance cleanly.
if getgenv()[GENV_STOP] then
	pcall(getgenv()[GENV_STOP])
end

local state = getgenv()[GENV]
if type(state) ~= 'table' then
	state = {}
	getgenv()[GENV] = state
end
state.enabled = state.enabled ~= false
state.notify = state.notify ~= false
state.webhook = type(state.webhook) == 'string' and state.webhook or ''
state.filter = state.filter or 'all' -- all | join | leave
state.entries = type(state.entries) == 'table' and state.entries or {}
state.widgetPos = state.widgetPos
state.guiPos = state.guiPos
state.guiSize = state.guiSize
state.panelOpen = true
-- autoBlock must not sticky-persist across reloads when PlayerTools/IY say off.
-- Cleared here; boot syncs from AutoBlock.iy / PlayerTools/autoblock / toggle.
state.autoBlock = false
state.autoEpoch = (tonumber(state.autoEpoch) or 0) + 1
local AUTO_EPOCH = state.autoEpoch

-- #region agent log
pcall(function()
	local payload = game:GetService('HttpService'):JSONEncode({
		sessionId = '7e9135',
		hypothesisId = 'JL1',
		location = 'JoinLogs.iy:state-init',
		message = 'reset sticky autoBlock on load',
		data = {
			iyOwner = getgenv().SB2AutoBlockIyOwner == true,
			fileOn = (type(isfile) == 'function' and isfile('PlayerTools/autoblock') and tostring(readfile('PlayerTools/autoblock')) == 'true') or false,
		},
		timestamp = os.time() * 1000,
	})
	if type(appendfile) == 'function' then
		pcall(appendfile, 'PlayerTools/debug-7e9135.log', payload .. '\n')
	end
end)
