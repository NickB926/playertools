local MIN_PANEL_W = 260
local MIN_PANEL_H = 220
local GUI_LAYOUT_PATHS = {
	'PlayerTools/joinlogs_gui.json',
	'joinlogs_gui.json',
}

local function say(text)
	pcall(function()
		StarterGui:SetCore('SendNotification', {
			Title = 'JoinLogs',
			Text = tostring(text),
			Duration = 3.5,
		})
	end)
	warn('[JoinLogs] ' .. tostring(text))
end

local function notifyToast(title, text)
	if not state.notify then
		return
	end
	pcall(function()
		StarterGui:SetCore('SendNotification', {
			Title = tostring(title),
			Text = tostring(text),
			Duration = 4,
		})
	end)
end

local function parentGui()
	local ok, hui = pcall(function()
		return gethui and gethui()
	end)
	if ok and hui then
		return hui
	end
	return game:GetService('CoreGui') or (LocalPlayer and LocalPlayer:FindFirstChild('PlayerGui'))
end

local function loadPillDock()
	if type(getgenv().SB2RegisterPill) == 'function' then
		return true
	end
	for _, path in ipairs({ 'PlayerTools/PillDock.lua', 'PillDock.lua' }) do
		local ok, src = pcall(function()
			return readfile(path)
		end)
		if ok and type(src) == 'string' and #src > 50 then
			local okLoad = pcall(function()
				assert(loadstring(src))()
			end)
			if okLoad and type(getgenv().SB2RegisterPill) == 'function' then
				return true
			end
		end
	end
	return false
end

local function registerJlPill()
	if not loadPillDock() then
		return nil
	end
	return getgenv().SB2RegisterPill({
		id = 'JL',
		text = state.enabled and 'JL' or 'JL·',
		textColor = state.enabled and Color3.fromRGB(170, 210, 255) or Color3.fromRGB(140, 140, 150),
		strokeColor = Color3.fromRGB(70, 100, 140),
		onClick = function()
			local fn = getgenv().SB2JoinLogsToggleGui
			if type(fn) == 'function' then
				fn()
			end
		end,
	})
end

local function disconnectOld()
	local conns = getgenv()[GENV_CONNS]
	if type(conns) == 'table' then
		for _, c in ipairs(conns) do
			pcall(function()
				c:Disconnect()
			end)
		end
	end
	getgenv()[GENV_CONNS] = {}
end

local function track(conn)
	local conns = getgenv()[GENV_CONNS]
	if type(conns) ~= 'table' then
		conns = {}
		getgenv()[GENV_CONNS] = conns
	end
	conns[#conns + 1] = conn
	return conn
end

local function destroyGui()
	disconnectOld()
	local gui = getgenv()[GENV_GUI]
	if gui and gui.Parent then
		pcall(function()
			gui:Destroy()
		end)
	end
	getgenv()[GENV_GUI] = nil
end

local function pad2(n)
	n = math.floor(tonumber(n) or 0)
	return (n < 10 and '0' or '') .. tostring(n)
end

local function stamp(t)
	t = t or os.time()
	local d = os.date('*t', t)
	return ('%s:%s:%s'):format(pad2(d.hour), pad2(d.min), pad2(d.sec))
end

local function stampFull(t)
	t = t or os.time()
	local d = os.date('*t', t)
	return ('%04d-%02d-%02d %s:%s:%s'):format(d.year, d.month, d.day, pad2(d.hour), pad2(d.min), pad2(d.sec))
end

local function udimFromSaved(saved, fallback)
	if type(saved) == 'table' and saved.xs ~= nil then
		return UDim2.new(saved.xs, saved.xo, saved.ys, saved.yo)
	end
	return fallback
end

local function persistPos(key, guiObject)
	if not guiObject then
		return
	end
	state[key] = {
		xs = guiObject.Position.X.Scale,
		xo = guiObject.Position.X.Offset,
		ys = guiObject.Position.Y.Scale,
		yo = guiObject.Position.Y.Offset,
	}
end

local function persistSize(guiObject)
	if not guiObject then
		return
	end
	local sz = guiObject.AbsoluteSize
	state.guiSize = {
		w = math.max(MIN_PANEL_W, math.floor((sz.X > 0 and sz.X or guiObject.Size.X.Offset) + 0.5)),
		h = math.max(MIN_PANEL_H, math.floor((sz.Y > 0 and sz.Y or guiObject.Size.Y.Offset) + 0.5)),
	}
end

local function sizeFromSaved(size, fallbackW, fallbackH)
	local w = fallbackW
	local h = fallbackH
	if type(size) == 'table' then
		w = tonumber(size.w) or w
		h = tonumber(size.h) or h
	end
	return math.max(MIN_PANEL_W, math.floor(w + 0.5)), math.max(MIN_PANEL_H, math.floor(h + 0.5))
end

local function loadGuiLayoutFile()
	if type(readfile) ~= 'function' then
		return
	end
	for _, path in ipairs(GUI_LAYOUT_PATHS) do
		local okExists, exists = pcall(function()
			return isfile and isfile(path)
		end)
		if okExists and exists then
			local okRead, body = pcall(readfile, path)
			if okRead and type(body) == 'string' and body ~= '' then
				local okJson, data = pcall(function()
					return HttpService:JSONDecode(body)
				end)
				if okJson and type(data) == 'table' then
					if type(data.pos) == 'table' then
						state.guiPos = data.pos
					end
					if type(data.size) == 'table' then
						state.guiSize = data.size
					end
					-- autoBlock is owned by PlayerTools profile / PlayerTools/autoblock — do not restore from JL layout.
					return
				end
			end
		end
	end
end

local function saveGuiLayoutFile()
	if type(writefile) ~= 'function' then
		return
	end
	if type(makefolder) == 'function' and type(isfolder) == 'function' then
		pcall(function()
			if not isfolder('PlayerTools') then
				makefolder('PlayerTools')
			end
		end)
	end
	local okJson, body = pcall(function()
		return HttpService:JSONEncode({
			pos = state.guiPos,
			size = state.guiSize,
		})
	end)
	if not okJson or type(body) ~= 'string' then
		return
	end
	for _, path in ipairs(GUI_LAYOUT_PATHS) do
		pcall(writefile, path, body)
	end
end

loadGuiLayoutFile()

local function makeDraggable(guiObject, persistKey, onClickIfNotDrag)
	local dragging = false
	local dragDist = 0
	local dragStart, startPos
	track(guiObject.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			dragging = true
			dragDist = 0
			dragStart = input.Position
			startPos = guiObject.Position
		end
	end))
	local function endDrag()
		if not dragging then
			return
		end
		dragging = false
		if dragDist >= 4 then
			persistPos(persistKey, guiObject)
			if persistKey == 'guiPos' then
				saveGuiLayoutFile()
			end
		elseif onClickIfNotDrag then
			onClickIfNotDrag()
		end
	end
	track(guiObject.InputEnded:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			endDrag()
		end
	end))
	track(UserInputService.InputEnded:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			endDrag()
		end
	end))
	track(UserInputService.InputChanged:Connect(function(input)
		if not dragging then
			return
		end
		if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
			local delta = input.Position - dragStart
			dragDist = math.max(dragDist, math.abs(delta.X) + math.abs(delta.Y))
			guiObject.Position = UDim2.new(
				startPos.X.Scale,
				startPos.X.Offset + delta.X,
				startPos.Y.Scale,
				startPos.Y.Offset + delta.Y
			)
		end
	end))
end

local function makeResizable(frame, onEnd)
	local grip = Instance.new('TextButton')
	grip.Name = 'Resize'
	grip.Size = UDim2.fromOffset(18, 18)
	grip.Position = UDim2.new(1, -20, 1, -20)
	grip.BackgroundColor3 = Color3.fromRGB(50, 56, 66)
	grip.BorderSizePixel = 0
	grip.AutoButtonColor = true
	grip.Text = ''
	grip.ZIndex = 5
	grip.Parent = frame
	Instance.new('UICorner', grip).CornerRadius = UDim.new(0, 4)
	local mark = Instance.new('TextLabel')
	mark.BackgroundTransparency = 1
	mark.Size = UDim2.fromScale(1, 1)
	mark.Font = Enum.Font.GothamBold
	mark.TextSize = 11
	mark.TextColor3 = Color3.fromRGB(160, 170, 185)
	mark.Text = '⌟'
	mark.ZIndex = 6
	mark.Parent = grip

	local resizing = false
	local dragStart, startSize
	local function endResize()
		if not resizing then
			return
		end
		resizing = false
		if onEnd then
			onEnd()
		end
	end
	track(grip.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			resizing = true
			dragStart = input.Position
			startSize = frame.AbsoluteSize
		end
	end))
	track(grip.InputEnded:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			endResize()
		end
	end))
	track(UserInputService.InputEnded:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			endResize()
		end
	end))
	track(UserInputService.InputChanged:Connect(function(input)
		if not resizing or not dragStart or not startSize then
			return
		end
		if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
			local delta = input.Position - dragStart
			local cam = workspace.CurrentCamera
			local vp = cam and cam.ViewportSize or Vector2.new(1280, 720)
			local w = math.clamp(startSize.X + delta.X, MIN_PANEL_W, math.max(MIN_PANEL_W, vp.X - 16))
			local h = math.clamp(startSize.Y + delta.Y, MIN_PANEL_H, math.max(MIN_PANEL_H, vp.Y - 16))
			frame.Size = UDim2.fromOffset(math.floor(w + 0.5), math.floor(h + 0.5))
		end
	end))
	return grip
end

local function setClipboard(text)
	text = tostring(text or '')
	if type(setclipboard) == 'function' then
		pcall(setclipboard, text)
		return true
	end
	if type(toclipboard) == 'function' then
		pcall(toclipboard, text)
		return true
	end
	return false
end

local function coreGui()
	local cg = game:GetService('CoreGui')
	if cloneref then
		pcall(function()
			cg = cloneref(cg)
		end)
	end
	return cg
end

local function buttonPlainText(obj)
	local text = ''
	pcall(function()
		text = tostring(obj.Text or '')
	end)
	if text == '' then
		pcall(function()
			text = tostring(obj.ContentText or '')
		end)
	end
	return (string.lower(text):gsub('^%s+', ''):gsub('%s+$', ''))
end

local function findBlockingModal()
	local cg = coreGui()
	for _, child in ipairs(cg:GetChildren()) do
		if child.Name == 'FoundationOverlay' then
			local screen = child:FindFirstChild('BlockingModalScreen', true)
			if screen then
				return screen
			end
		end
	end
	return nil
end

local function findModalBlockButton()
	local screen = findBlockingModal()
	if not screen then
		return nil
	end
	local root = screen:FindFirstChild('Buttons', true) or screen
	local function labelOf(inst)
		local text = buttonPlainText(inst)
		if text ~= '' then
			return text
		end
		local ok, descendants = pcall(function()
			return inst:GetDescendants()
		end)
		if ok and type(descendants) == 'table' then
			for _, d in ipairs(descendants) do
				local t = buttonPlainText(d)
				if t ~= '' then
					return t
				end
			end
		end
		return ''
	end
	for _, child in ipairs(root:GetChildren()) do
		if labelOf(child) == 'block' then
			if child:IsA('GuiButton') then
				return child
			end
			local btn = child:FindFirstAncestorWhichIsA('GuiButton')
			if btn then
				return btn
			end
			for _, d in ipairs(child:GetDescendants()) do
				if d:IsA('GuiButton') then
					return d
				end
			end
			return child
		end
	end
	return nil
end

local function buttonCenter(btn)
	if not btn then
		return nil
	end
	local insetY = 0
	pcall(function()
		insetY = GuiService:GetGuiInset().Y
	end)
	local pos = btn.AbsolutePosition
	local size = btn.AbsoluteSize
	return pos.X + size.X / 2, pos.Y + size.Y / 2 + insetY
end

local function focusThisClient()
	pcall(function()
		local cam = workspace.CurrentCamera
		local vs = cam and cam.ViewportSize
		local fx = vs and (vs.X * 0.5) or 400
		local fy = vs and math.min(40, vs.Y * 0.05) or 20
		if type(mousemoveabs) == 'function' then
			mousemoveabs(fx, fy)
		else
			VirtualInputManager:SendMouseMoveEvent(fx, fy, game)
		end
		if type(mouse1click) == 'function' then
			mouse1click()
		else
			VirtualInputManager:SendMouseButtonEvent(fx, fy, 0, true, game, 1)
			VirtualInputManager:SendMouseButtonEvent(fx, fy, 0, false, game, 1)
		end
	end)
	task.wait(0.05)
end

local function clickBlockWithMouse(btn)
	if not btn then
		return
	end
	local x, y = buttonCenter(btn)
	if not x then
		return
	end
	focusThisClient()
	pcall(function()
		if type(mousemoveabs) == 'function' then
			mousemoveabs(x, y)
		else
			VirtualInputManager:SendMouseMoveEvent(x, y, game)
		end
	end)
	task.wait(0.02)
	pcall(function()
		if type(mouse1click) == 'function' then
			mouse1click()
		else
			VirtualInputManager:SendMouseButtonEvent(x, y, 0, true, game, 1)
			VirtualInputManager:SendMouseButtonEvent(x, y, 0, false, game, 1)
		end
	end)
end

local function confirmBlockButton(btn)
	task.wait(ACTION_DELAY)
	if not btn then
		btn = findModalBlockButton()
	end
	if btn then
		clickBlockWithMouse(btn)
	end
	task.wait(ACTION_DELAY)
end

local function autoConfirmBlockPrompt()
	task.spawn(function()
		local done = false
		local function tryClick()
			if done then
				return false
			end
			local btn = findModalBlockButton()
			if not btn and not findBlockingModal() then
				return false
			end
			done = true
			confirmBlockButton(btn)
			return true
		end
		local conn
		pcall(function()
			conn = coreGui().DescendantAdded:Connect(function(inst)
				if inst.Name == 'BlockingModalScreen' or inst.Name == 'BlockingModal' then
					task.delay(ACTION_DELAY, tryClick)
				end
			end)
		end)
		for _ = 1, 40 do
			if tryClick() then
				break
			end
			task.wait(0.15)
		end
		if conn then
			pcall(function()
				conn:Disconnect()
			end)
		end
	end)
end

local function readHopState()
	if type(readfile) ~= 'function' or type(isfile) ~= 'function' then
		return nil
	end
	local okExists, exists = pcall(isfile, HOP_PATH)
	if not (okExists and exists) then
		return nil
	end
	local okRead, body = pcall(readfile, HOP_PATH)
	if not (okRead and type(body) == 'string' and body ~= '') then
		return nil
	end
	local okJson, data = pcall(function()
		return HttpService:JSONDecode(body)
	end)
	if okJson and type(data) == 'table' then
		return data
	end
	return nil
end

local function writeHopState(data)
	if type(writefile) ~= 'function' then
		return
	end
	if type(makefolder) == 'function' and type(isfolder) == 'function' then
		pcall(function()
			if not isfolder('PlayerTools') then
				makefolder('PlayerTools')
			end
		end)
	end
	local okJson, body = pcall(function()
		return HttpService:JSONEncode(data)
	end)
	if okJson and type(body) == 'string' then
		pcall(writefile, HOP_PATH, body)
	end
	getgenv().SB2AutoBlockHop = data
end

local function hopInProgress()
	local hop = readHopState() or getgenv().SB2AutoBlockHop
	return type(hop) == 'table' and hop.active == true
end

local function armThenTeleport(placeId, label)
	if type(getgenv().SB2PlayerToolsArmTeleport) == 'function' then
		pcall(getgenv().SB2PlayerToolsArmTeleport)
	end
	-- Do not clear SoloCombatResume here — that fought the PlayerTools profile.
	-- PlayerTools hop uses SB2AutoBlockHopping to pause resume until F11 lands.
	getgenv().SB2AutoBlockHopping = true
	if type(getgenv().SB2CloseAllPillPanels) == 'function' then
		pcall(getgenv().SB2CloseAllPillPanels)
	end
	say(label or ('joining ' .. tostring(placeId)))
	local ok, err = pcall(function()
		TeleportService:Teleport(placeId, LocalPlayer)
	end)
	if not ok then
		say('teleport failed: ' .. tostring(err))
		return false
	end
	return true
end

local function startF1ThenF11Hop()
	-- Direct F11 only. Never bounce through F1 (that yanked people off other floors).
	-- Only hop when already on F11 (contested farm server) or F1 mid-legacy hop.
	local pid = game.PlaceId
	if pid ~= F11_PLACE and pid ~= F1_PLACE then
		writeHopState({
			active = false,
			phase = 'off',
			auto = true,
			t = os.time(),
		})
		getgenv().SB2AutoBlockHopping = nil
		say('auto-block hop skipped — not on F11')
		return false
	end
	writeHopState({
		active = true,
		phase = 'f11',
		auto = true,
		t = os.time(),
	})
	return armThenTeleport(F11_PLACE, 'joining F11 Hypersiddia…')
end

local autoTimers = {}
local autoBusy = false
local autoStatusText = 'idle'
local paintAuto -- filled after GUI builds

local function setAutoStatus(text)
	autoStatusText = tostring(text or 'idle')
	if type(paintAuto) == 'function' then
		pcall(paintAuto)
	end
end

local function cancelAutoTimer(userId)
	userId = tonumber(userId)
	if not userId then
		return
	end
	local rec = autoTimers[userId]
	if rec then
		rec.cancelled = true
		autoTimers[userId] = nil
	end
end

local function cancelAllAutoTimers()
	for userId, rec in pairs(autoTimers) do
		if rec then
			rec.cancelled = true
		end
		autoTimers[userId] = nil
	end
	if not autoBusy then
		setAutoStatus(state.autoBlock and 'watching' or 'off')
	end
end

local function soonestTimer()
	local best, bestAt = nil, nil
	for _, rec in pairs(autoTimers) do
		if rec and not rec.cancelled then
			if not bestAt or rec.deadline < bestAt then
				best = rec
				bestAt = rec.deadline
			end
		end
	end
	return best
end

local function promptBlockPlayer(entry)
	local userId = tonumber(entry and entry.userId)
	if not userId or userId <= 0 then
		say('no userId to block')
		return false
	end
	if LocalPlayer and userId == LocalPlayer.UserId then
		say("can't block yourself")
		return false
	end
	local plr = Players:GetPlayerByUserId(userId)
	if not plr then
		say('player left — open their profile to block')
		local url = ('https://www.roblox.com/users/%s/profile'):format(tostring(userId))
		local opened = pcall(function()
			GuiService:OpenBrowserWindow(url)
		end)
		if not opened then
			if setClipboard(url) then
				say('copied profile URL')
			else
				say(url)
			end
		end
		return false
	end
	autoConfirmBlockPrompt()
	task.wait(ACTION_DELAY)
	local ok = pcall(function()
		StarterGui:SetCore('PromptBlockPlayer', plr)
	end)
	if not ok then
		ok = pcall(function()
			StarterGui:SetCore('PromptBlockPlayer', { Player = plr })
		end)
	end
	if not ok then
		say('block prompt failed')
		return false
	end
	return true
end

local function runAutoBlockSequence(plr)
	if getgenv().SB2AutoBlockIyOwner == true then
		return
	end
	if autoBusy or not plr or plr == LocalPlayer then
		return
	end
	if state.autoEpoch ~= AUTO_EPOCH then
		return
	end
	if not Players:GetPlayerByUserId(plr.UserId) then
		return
	end
	autoBusy = true
	setAutoStatus('blocking ' .. tostring(plr.DisplayName or plr.Name))
	say(('1m up — blocking %s'):format(tostring(plr.DisplayName or plr.Name)))
	local okRun, errRun = pcall(function()
		task.wait(ACTION_DELAY)
		if not Players:GetPlayerByUserId(plr.UserId) then
			return
		end
		local opened = pcall(function()
			StarterGui:SetCore('PromptBlockPlayer', plr)
		end)
		if not opened then
			opened = pcall(function()
				StarterGui:SetCore('PromptBlockPlayer', { Player = plr })
			end)
		end
		if not opened then
			say('block prompt failed')
			return
		end
		task.wait(ACTION_DELAY)
		local untilT = os.clock() + 8
		while os.clock() < untilT do
			local btn = findModalBlockButton()
			if btn or findBlockingModal() then
				confirmBlockButton(btn)
				break
			end
			task.wait(0.15)
		end
		task.wait(ACTION_DELAY)
		if not state.autoBlock then
			return
		end
		if not Players:GetPlayerByUserId(plr.UserId) and not findBlockingModal() then
			-- they left during the prompt; still hop to a fresh F11
		end
		cancelAllAutoTimers()
		startF1ThenF11Hop()
	end)
	autoBusy = false
	if not okRun then
		setAutoStatus('error')
		say('auto block error: ' .. tostring(errRun))
	end
end

local function startAutoTimer(plr, waitSec)
	-- AutoBlock.iy owns join blocking — never run JoinLogs' parallel 1m timers.
	if getgenv().SB2AutoBlockIyOwner == true then
		return
	end
	if not state.autoBlock or not plr or plr == LocalPlayer or isOwnAlt(plr) then
		return
	end
	-- #region agent log
	pcall(function()
		local payload = game:GetService('HttpService'):JSONEncode({
			sessionId = '7e9135',
			hypothesisId = 'JL2',
			location = 'JoinLogs.iy:startAutoTimer',
			message = 'JoinLogs arming timer',
			data = {
				name = tostring(plr and (plr.DisplayName or plr.Name)),
				autoBlock = state.autoBlock == true,
			},
			timestamp = os.time() * 1000,
		})
		if type(appendfile) == 'function' then
			pcall(appendfile, 'PlayerTools/debug-7e9135.log', payload .. '\n')
		end
	end)
	-- #endregion
	if hopInProgress() then
		return
	end
	local userId = plr.UserId
	waitSec = tonumber(waitSec)
	if waitSec == nil then
		waitSec = AUTO_BLOCK_WAIT
	end
	local immediate = waitSec <= 0.05
	if autoTimers[userId] then
		if not immediate then
			return
		end
		cancelAutoTimer(userId)
	end
	local rec = {
		userId = userId,
		name = tostring(plr.DisplayName or plr.Name),
		deadline = os.clock() + math.max(0, waitSec),
		cancelled = false,
	}
	autoTimers[userId] = rec
	local function finishTimer()
		if rec.cancelled or autoTimers[userId] ~= rec or state.autoEpoch ~= AUTO_EPOCH then
			return
		end
		autoTimers[userId] = nil
		local still = Players:GetPlayerByUserId(userId)
		if not still then
			setAutoStatus(state.autoBlock and 'watching' or 'off')
			return
		end
		runAutoBlockSequence(still)
	end
	if immediate then
		setAutoStatus('blocking now · ' .. rec.name)
		say(('auto block now — %s (already here)'):format(rec.name))
		task.spawn(function()
			local spin = os.clock() + 20
			while autoBusy and os.clock() < spin do
				if rec.cancelled or autoTimers[userId] ~= rec then
					return
				end
				task.wait(0.15)
			end
			finishTimer()
		end)
		return
	end
	setAutoStatus(('1m · %s'):format(rec.name))
	say(('auto block in 1m — %s'):format(rec.name))
	task.spawn(function()
		while autoTimers[userId] == rec and not rec.cancelled and state.autoEpoch == AUTO_EPOCH do
			local left = rec.deadline - os.clock()
			if left <= 0 then
				break
			end
			setAutoStatus(('%ds · %s'):format(math.ceil(left), rec.name))
			task.wait(0.5)
		end
		finishTimer()
	end)
end

local function armAutoTimersForPresent(waitSec)
	if getgenv().SB2AutoBlockIyOwner == true then
		return
	end
	if not state.autoBlock then
		return
	end
	if hopInProgress() then
		return
	end
	if waitSec == nil then
		waitSec = 0
	end
	for _, plr in ipairs(Players:GetPlayers()) do
		startAutoTimer(plr, waitSec)
	end
	if not soonestTimer() then
		setAutoStatus('watching')
	end
end
-- Never steal AutoBlock.iy's arm export.
if getgenv().SB2AutoBlockIyOwner ~= true then
	getgenv().SB2ArmAutoBlockTimers = armAutoTimersForPresent
end

local function syncPlayerToolsAutoBlock(on)
	pcall(function()
		local t = Toggles and Toggles.AutoBlockJoin
		if type(t) == 'table' and type(t.SetValue) == 'function' and t.Value ~= on then
			t:SetValue(on)
		end
	end)
end

local function setAutoBlockEnabled(on, silent)
	on = on == true
	-- AutoBlock.iy owns the early path — don't fight it / don't run JL timers.
	if getgenv().SB2AutoBlockIyOwner == true then
		state.autoBlock = false
		cancelAllAutoTimers()
		if type(getgenv().SB2SetAutoBlock) == 'function' then
			pcall(getgenv().SB2SetAutoBlock, on, silent == true, { userChoice = true, persist = true })
		end
		setAutoStatus(on and 'IY owns auto-block' or 'off (IY)')
		if type(paintAuto) == 'function' then
			pcall(paintAuto)
		end
		return on
	end
	local changed = state.autoBlock ~= on
	state.autoBlock = on
	if changed then
		saveGuiLayoutFile()
	end
	if on then
		setAutoStatus('watching')
		armAutoTimersForPresent()
		if not silent and changed then
			say('auto block on — 1m if someone joins while you are solo')
		end
	else
		cancelAllAutoTimers()
		setAutoStatus('off')
		getgenv().SB2AutoBlockWanted = false
		getgenv().SB2AutoBlockHopping = nil
		writeHopState({
			active = false,
			phase = 'off',
			t = os.time(),
		})
		if not silent and changed then
			say('auto block off')
		end
	end
	if type(paintAuto) == 'function' then
		pcall(paintAuto)
	end
	syncPlayerToolsAutoBlock(on)
	return on
end
if getgenv().SB2AutoBlockIyOwner ~= true then
	getgenv().SB2SetAutoBlock = function(on)
		return setAutoBlockEnabled(on == true, true)
	end
	getgenv().SB2GetAutoBlock = function()
		return state.autoBlock == true
	end
end

local function ensureLogFolder()
	if type(isfolder) == 'function' and type(makefolder) == 'function' then
		local ok, exists = pcall(isfolder, 'PlayerTools')
		if ok and not exists then
			pcall(makefolder, 'PlayerTools')
		end
	end
end

local function appendFile(line)
	if type(appendfile) ~= 'function' and type(writefile) ~= 'function' then
		return
	end
	ensureLogFolder()
	local path = SAVE_PATH
	if type(appendfile) == 'function' then
		pcall(appendfile, path, line .. '\n')
		return
	end
	local prev = ''
	if type(isfile) == 'function' and type(readfile) == 'function' then
		local ok, exists = pcall(isfile, path)
		if ok and exists then
			local rok, body = pcall(readfile, path)
			if rok and type(body) == 'string' then
				prev = body
			end
		end
	end
	pcall(writefile, path, prev .. line .. '\n')
end

local function httpRequest(opts)
	local req = (syn and syn.request)
		or http_request
		or (http and http.request)
		or request
	if type(req) ~= 'function' then
		return false, 'no request'
	end
	local ok, res = pcall(req, opts)
	return ok, res
end

local function sendWebhook(entry)
	local url = state.webhook
	if type(url) ~= 'string' or url == '' or not url:find('discord.com/api/webhooks') then
		return
	end
	local color = entry.kind == 'leave' and 0xE06C75 or 0x98C379
	if entry.friend then
		color = 0x61AFEF
	elseif entry.newAccount then
		color = 0xE5C07B
	end
	local content = ('**%s** `%s` (%s) — age %sd%s'):format(
		entry.kind == 'leave' and 'LEFT' or 'JOINED',
		entry.username,
		tostring(entry.userId),
		tostring(entry.accountAge or '?'),
		entry.friend and ' · friend' or ''
	)
	task.spawn(function()
		httpRequest({
			Url = url,
			Method = 'POST',
			Headers = { ['Content-Type'] = 'application/json' },
			Body = HttpService:JSONEncode({
				embeds = {
					{
						title = entry.displayName ~= entry.username
								and (entry.displayName .. ' (@' .. entry.username .. ')')
							or entry.username,
						description = content,
						color = color,
						footer = { text = 'Place ' .. tostring(game.PlaceId) .. ' · Job ' .. tostring(game.JobId) },
						timestamp = os.date('!%Y-%m-%dT%H:%M:%SZ', entry.time),
					},
				},
			}),
		})
	end)
end

local function playerMeta(plr)
	local username = plr and plr.Name or '?'
	local display = username
	local userId = plr and plr.UserId or 0
	local age = 0
	local friend = false
	pcall(function()
		display = plr.DisplayName or username
	end)
	pcall(function()
		age = plr.AccountAge or 0
	end)
	pcall(function()
		if LocalPlayer and plr and plr ~= LocalPlayer then
			friend = LocalPlayer:IsFriendsWith(plr.UserId)
		end
	end)
	return {
		username = username,
		displayName = display,
		userId = userId,
		accountAge = age,
		friend = friend == true,
		newAccount = (tonumber(age) or 9999) <= NEW_ACCOUNT_DAYS,
	}
end

local refreshGui

-- Drop presence rows (HERE / JOIN) for a user — used when they leave so names don't linger.
local function clearPresence(userId)
	userId = tonumber(userId)
	if not userId then
		return 0
	end
	local list = state.entries
	local kept = {}
	local removed = 0
	for _, e in ipairs(list) do
		if tonumber(e.userId) == userId and (e.kind == 'here' or e.kind == 'join') then
			removed += 1
		else
			kept[#kept + 1] = e
		end
	end
	state.entries = kept
	return removed
end

local function pushEntry(kind, plr, opts)
	opts = opts or {}
	if not state.enabled and not opts.force then
		return
	end
	local meta = typeof(plr) == 'Instance' and playerMeta(plr) or plr
	if type(meta) ~= 'table' then
		return
	end
	-- Leaving: wipe their name from the roster first, then log LEFT.
	if kind == 'leave' then
		clearPresence(meta.userId)
	end
	-- Re-joining: drop an old LEFT so the list shows them as present again.
	if kind == 'join' or kind == 'here' then
		local list = state.entries
		local kept = {}
		for _, e in ipairs(list) do
			if not (tonumber(e.userId) == tonumber(meta.userId) and e.kind == 'leave') then
				kept[#kept + 1] = e
			end
		end
		state.entries = kept
	end
	local entry = {
		kind = kind, -- join | leave | here
		time = os.time(),
		username = meta.username,
		displayName = meta.displayName,
		userId = meta.userId,
		accountAge = meta.accountAge,
		friend = meta.friend,
		newAccount = meta.newAccount,
		placeId = game.PlaceId,
		jobId = game.JobId,
	}
	local list = state.entries
	list[#list + 1] = entry
	while #list > MAX_ENTRIES do
		table.remove(list, 1)
	end

	local line = ('[%s] %s  %s (@%s)  id=%s  age=%sd%s%s'):format(
		stampFull(entry.time),
		string.upper(entry.kind),
		entry.displayName,
		entry.username,
		tostring(entry.userId),
		tostring(entry.accountAge or '?'),
		entry.friend and '  friend' or '',
		entry.newAccount and '  NEW' or ''
	)
	appendFile(line)

	if kind == 'join' or kind == 'leave' then
		local tag = kind == 'join' and 'joined' or 'left'
		local extra = ''
		if entry.friend then
			extra = ' (friend)'
		elseif entry.newAccount then
			extra = (' (new · %sd)'):format(tostring(entry.accountAge))
		end
		notifyToast(
			kind == 'join' and 'Player joined' or 'Player left',
			('%s%s'):format(entry.username, extra)
		)
		sendWebhook(entry)
	end

	if refreshGui then
		task.defer(refreshGui)
	end
	return entry
end

local function filteredEntries()
	local q = string.lower(tostring(state.search or ''))
	local filter = state.filter or 'all'
	local out = {}
	for i = #state.entries, 1, -1 do
		local e = state.entries[i]
		if filter == 'all' or e.kind == filter or (filter == 'join' and e.kind == 'here') then
			if q == ''
				or string.find(string.lower(e.username), q, 1, true)
				or string.find(string.lower(e.displayName), q, 1, true)
				or string.find(tostring(e.userId), q, 1, true)
			then
				out[#out + 1] = e
			end
		end
	end
	return out
end

local function setPanelOpen(open)
	open = open == true
	state.panelOpen = open
	local gui = getgenv()[GENV_GUI]
	local main = gui and gui:FindFirstChild('Main')
	if main then
		main.Visible = open
	end
end

local function togglePanel()
	local gui = getgenv()[GENV_GUI]
	local main = gui and gui:FindFirstChild('Main')
	if not main then
		return false
	end
	setPanelOpen(not main.Visible)
	return main.Visible
end

local function mkBtn(parent, text, size, pos, bg)
	local b = Instance.new('TextButton')
	b.Size = size
	b.Position = pos
	b.BackgroundColor3 = bg or Color3.fromRGB(40, 44, 52)
	b.BorderSizePixel = 0
	b.AutoButtonColor = true
	b.Font = Enum.Font.GothamBold
	b.TextSize = 12
	b.TextColor3 = Color3.fromRGB(220, 224, 232)
	b.Text = text
	b.Parent = parent
	Instance.new('UICorner', b).CornerRadius = UDim.new(0, 6)
	return b
end

local function buildGui()
	destroyGui()

	local gui = Instance.new('ScreenGui')
	gui.Name = 'SB2JoinLogsGui'
	gui.ResetOnSpawn = false
	gui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
	gui.DisplayOrder = 105
	pcall(function()
		gui.Parent = parentGui()
	end)
	if not gui.Parent and LocalPlayer then
		gui.Parent = LocalPlayer:WaitForChild('PlayerGui')
	end
	getgenv()[GENV_GUI] = gui
	pcall(registerJlPill)

	-- Pill lives in shared SB2PillDock — panel only here.
	local frame = Instance.new('Frame')
	frame.Name = 'Main'
	local savedW, savedH = sizeFromSaved(state.guiSize, 360, 460)
	frame.Size = UDim2.fromOffset(savedW, savedH)
