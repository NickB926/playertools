getgenv().SB2SoftPlayerToolsReload=true; getgenv().SB2PlayerToolsLoading=true; getgenv().SB2PlayerToolsLoadingSince=os.clock(); getgenv().SB2PlayerTools=false; getgenv().SB2PlayerToolsLibrary=nil
local p=(isfile and isfile('PlayerTools/launch.lua') and 'PlayerTools/launch.lua') or (isfile and isfile('PlayerTools/PlayerTools.lua') and 'PlayerTools/PlayerTools.lua') or (isfile and isfile('PlayerTools.lua') and 'PlayerTools.lua')
if not p then getgenv().SB2PlayerToolsLoading=false; getgenv().SB2SoftPlayerToolsReload=nil; return end
