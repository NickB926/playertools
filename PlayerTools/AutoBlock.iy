--[[
    AutoBlock.iy — Infinite Yield plugin (Swordburst 2)

    Owns auto-block EARLY (IY loads before PlayerTools). Watches joins,
    PromptBlockPlayer + click Block, then hops F11. PlayerTools UI only
    toggles PlayerTools/autoblock + calls getgenv().SB2SetAutoBlock.

    Install: IY Plugins → Add → AutoBlock.iy (this file)
    Commands: abon | aboff | abstatus | abarm

    Shared state:
      PlayerTools/autoblock
      PlayerTools/autoblock_hop_<account>.json
      getgenv().SB2AutoBlockIyOwner / SB2AutoBlockJoinConn / SB2AutoBlockBusy
]]

local Players = game:GetService('Players')
local HttpService = game:GetService('HttpService')
local TeleportService = game:GetService('TeleportService')
local GuiService = game:GetService('GuiService')
local StarterGui = game:GetService('StarterGui')
local VirtualInputManager = game:GetService('VirtualInputManager')
local LocalPlayer = Players.LocalPlayer
	or Players:GetPropertyChangedSignal('LocalPlayer'):Wait()
	or Players.LocalPlayer

local GENV_STOP = 'SB2AutoBlockIyStop'
local FOLDER = 'PlayerTools'

-- #region agent log
local DEBUG_LOG_PATH = FOLDER .. '/debug-7e9135.log'
local function agentLog(hypothesisId, location, message, data)
	pcall(function()
		local payload = HttpService:JSONEncode({
			sessionId = '7e9135',
			hypothesisId = hypothesisId,
			location = location,
			message = message,
			data = data or {},
			timestamp = os.time() * 1000,
		})
		if type(writefile) == 'function' then
			pcall(appendfile, DEBUG_LOG_PATH, payload .. '\n')
		end
		pcall(function()
			HttpService:PostAsync(
				'http://127.0.0.1:7861/ingest/33b8acf6-21a2-4cac-86cb-3dd7bad0dfa2',
				payload,
				Enum.HttpContentType.ApplicationJson,
				false,
				{ ['X-Debug-Session-Id'] = '7e9135' }
			)
		end)
	end)
end
-- #endregion
local AUTOBLOCK_PATH = FOLDER .. '/autoblock'
local F1_PLACE = 542351431
local F11_PLACE = 5287433115
local AUTO_BLOCK_WAIT = 15
getgenv().SB2AutoBlockWait = AUTO_BLOCK_WAIT
local ACTION_DELAY = 0.5
local BLOCK_SETTLE_SEC = 1.4
local PRESENCE_WATCH_SEC = 2
local BLOCKED_USERS_PATH = FOLDER .. '/blocked_user_ids.json'
local FRESH_FLOOR_PATH = FOLDER .. '/fresh_finder_floor.json'

local HARD_STORY_FLOORS = {
	{ placeId = 542351431, name = 'Virhst Woodlands', floor = 1 },
	{ placeId = 548231754, name = 'Redveil Grove', floor = 2 },
	{ placeId = 555980327, name = 'Avalanche Expanse', floor = 3 },
	{ placeId = 572487908, name = 'Hidden Wilds', floor = 4 },
	{ placeId = 580239979, name = 'Desolate Dunes', floor = 5 },
	{ placeId = 566212942, name = 'Helmfirth', floor = 6 },
	{ placeId = 582198062, name = 'Entoloma Gloomlands', floor = 7 },
	{ placeId = 548878321, name = 'Blooming Plateau', floor = 8 },
	{ placeId = 573267292, name = "Va' Rok", floor = 9 },
	{ placeId = 2659143505, name = 'Transylvania', floor = 10 },
	{ placeId = 5287433115, name = 'Hypersiddia', floor = 11 },
	{ placeId = 6144637080, name = 'Sector - 235', floor = 12 },
}

local blockedUserIds = {}
local freshFinderWatchdogOn = false


local OWN_ALT_NAMES = {
	nickb928 = true,
	nickb925 = true,
	nickb926 = true,
	nickb910 = true,
	nickb929 = true,
	dyildolover = true,
	['62qx'] = true,
}

if getgenv()[GENV_STOP] then
	pcall(getgenv()[GENV_STOP])
end

getgenv().SB2AutoBlockIyOwner = true
getgenv().SB2AutoBlockIyReady = false

local function say(text)
	pcall(function()
		StarterGui:SetCore('SendNotification', {
			Title = 'AutoBlock',
			Text = tostring(text),
			Duration = 4,
		})
	end)
	warn('[AutoBlock.iy] ' .. tostring(text))
end

local function normalizeAltKey(raw)
	local s = string.lower(tostring(raw or ''))
	s = s:gsub('%s+', ''):gsub('[^%w_%-]', '')
	return s
end

local function accountFileKey()
	local name = normalizeAltKey(LocalPlayer and LocalPlayer.Name or 'unknown')
	if name == '' then
		name = 'unknown'
	end
	return name
end

local function hopPath()
	return FOLDER .. '/autoblock_hop_' .. accountFileKey() .. '.json'
end

local function ensureFolder()
	if type(makefolder) == 'function' and type(isfolder) == 'function' then
		pcall(function()
			if not isfolder(FOLDER) then
				makefolder(FOLDER)
			end
		end)
	end
end

local function isOwnAlt(plr)
	if type(getgenv().SB2IsOwnAlt) == 'function' and plr then
		local ok, result = pcall(getgenv().SB2IsOwnAlt, plr)
		if ok then
			return result == true
		end
	end
	if not plr then
		return false
	end
	local extras = rawget(getgenv(), 'SB2OwnAltNames')
	local name = normalizeAltKey(plr.Name)
	local display = normalizeAltKey(plr.DisplayName)
	return OWN_ALT_NAMES[name] == true
		or OWN_ALT_NAMES[display] == true
		or (type(extras) == 'table' and (extras[name] == true or extras[display] == true))
end

local function countStrangerPlayers()
	local n = 0
	for _, plr in ipairs(Players:GetPlayers()) do
		if plr ~= LocalPlayer and not isOwnAlt(plr) then
			n += 1
		end
	end
	return n
end

local function isSkipBlocked(plr)
	if not plr or not plr.UserId then
		return false
	end
	local skip = getgenv().SB2AutoBlockSkipUntil
	if type(skip) ~= 'table' then
		return false
	end
	local untilT = skip[plr.UserId]
	return type(untilT) == 'number' and os.clock() < untilT
end

local function persistBlockedUserId(userId)
	userId = tonumber(userId)
	if not userId then
		return
	end
	if blockedUserIds[userId] then
		return
	end
	blockedUserIds[userId] = true
	if type(writefile) ~= 'function' then
		return
	end
	ensureFolder()
	local arr = {}
	for id in pairs(blockedUserIds) do
		arr[#arr + 1] = id
	end
	table.sort(arr)
	local okJson, body = pcall(function()
		return HttpService:JSONEncode(arr)
	end)
	if okJson and type(body) == 'string' then
		pcall(writefile, BLOCKED_USERS_PATH, body)
	end
end

local function loadBlockedUserIds()
	blockedUserIds = {}
	if type(isfile) ~= 'function' or type(readfile) ~= 'function' then
		return
	end
	local ok, exists = pcall(isfile, BLOCKED_USERS_PATH)
	if not ok or not exists then
		return
	end
	local okRead, body = pcall(readfile, BLOCKED_USERS_PATH)
	if not okRead or type(body) ~= 'string' or body == '' then
		return
	end
	local okJson, data = pcall(function()
		return HttpService:JSONDecode(body)
	end)
	if not okJson or type(data) ~= 'table' then
		return
	end
	if data[1] ~= nil then
		for _, id in ipairs(data) do
			local n = tonumber(id)
			if n then
				blockedUserIds[n] = true
			end
		end
		return
	end
	for k, v in pairs(data) do
		local n = tonumber(k)
		if n and v ~= false then
			blockedUserIds[n] = true
		end
	end
end

-- Temporary cooldown only — do NOT persist. Persisting on failed modal/hop
-- permanently skips real players and causes hop loops without PromptBlockPlayer.
local function markSkipBlocked(plr, seconds)
	if not plr or not plr.UserId then
		return
	end
	getgenv().SB2AutoBlockSkipUntil = getgenv().SB2AutoBlockSkipUntil or {}
	getgenv().SB2AutoBlockSkipUntil[plr.UserId] = os.clock() + (tonumber(seconds) or 300)
end

-- Only after a real Roblox block (Unblock UI / confirmed modal close).
local function markConfirmedBlocked(plr, seconds)
	markSkipBlocked(plr, seconds or 300)
	if plr and plr.UserId then
		persistBlockedUserId(plr.UserId)
	end
end

local function unpersistBlockedUserId(userId)
	userId = tonumber(userId)
	if not userId or not blockedUserIds[userId] then
		return false
	end
	blockedUserIds[userId] = nil
	if type(writefile) ~= 'function' then
		return true
	end
	ensureFolder()
	local arr = {}
	for id in pairs(blockedUserIds) do
		arr[#arr + 1] = id
	end
	table.sort(arr)
	local okJson, body = pcall(function()
		return HttpService:JSONEncode(arr)
	end)
	if okJson and type(body) == 'string' then
		pcall(writefile, BLOCKED_USERS_PATH, body)
	end
	return true
end

local function isKnownBlocked(plr)
	if isSkipBlocked(plr) then
		return true
	end
	return plr and plr.UserId and blockedUserIds[plr.UserId] == true
end

-- Strangers who still need a block attempt (not already-known blocked).
local function countActionableStrangers()
	local n = 0
	for _, plr in ipairs(Players:GetPlayers()) do
		if plr ~= LocalPlayer and not isOwnAlt(plr) and not isKnownBlocked(plr) then
			n += 1
		end
	end
	return n
end

local function markJustLanded(seconds)
	local untilT = os.clock() + (tonumber(seconds) or 12)
	getgenv().SB2FreshJustLandedUntil = untilT
	return untilT
end

local function stillLanding()
	return os.clock() < (tonumber(getgenv().SB2FreshJustLandedUntil) or 0)
end

local function stopFreshFinderIfEmpty(reason)
	local strangers = countStrangerPlayers()
	if strangers > 0 then
		getgenv().SB2FreshEmptySince = nil
		return false
	end
	-- After a hop, other players often aren't replicated yet — don't kill finder.
	if stillLanding() then
		return false
	end
	-- Require a short stable empty window (not a single empty poll).
	local emptySince = tonumber(getgenv().SB2FreshEmptySince) or 0
	if emptySince <= 0 then
		getgenv().SB2FreshEmptySince = os.clock()
		return false
	end
	if (os.clock() - emptySince) < 4 then
		return false
	end
	getgenv().SB2FreshEmptySince = nil
	if type(getgenv().SB2StopFreshServerFinder) == 'function' then
		pcall(getgenv().SB2StopFreshServerFinder, reason or 'Empty server found on this floor')
	else
		writeFreshFinder({ active = false, placeId = game.PlaceId, tried = {}, hops = 0 })
		writeHop({ active = false, phase = 'off' })
		getgenv().SB2AutoBlockHopping = nil
		say(reason or 'Empty server found on this floor')
	end
	return true
end

local function fileOn()
	if type(isfile) == 'function' and type(readfile) == 'function' then
		local ok, exists = pcall(isfile, AUTOBLOCK_PATH)
		if ok and exists then
			local okRead, body = pcall(readfile, AUTOBLOCK_PATH)
			if okRead then
				return tostring(body) == 'true'
			end
		end
	end
	return getgenv().SB2AutoBlockWanted == true
end

local function writeFile(on)
	ensureFolder()
	if type(writefile) == 'function' then
		pcall(writefile, AUTOBLOCK_PATH, on and 'true' or 'false')
	end
end

local function readHop()
	local path = hopPath()
	if type(isfile) == 'function' and type(readfile) == 'function' then
		local ok, exists = pcall(isfile, path)
		if ok and exists then
			local okRead, body = pcall(readfile, path)
			if okRead and type(body) == 'string' and body ~= '' then
				local okJson, data = pcall(function()
					return HttpService:JSONDecode(body)
				end)
				if okJson and type(data) == 'table' then
					return data
				end
			end
		end
	end
	local shared = getgenv().SB2AutoBlockHop
	if type(shared) == 'table' then
		return shared
	end
	return nil
end

local function writeHop(data)
	ensureFolder()
	data = type(data) == 'table' and data or {}
	data.owner = accountFileKey()
	data.t = data.t or os.time()
	getgenv().SB2AutoBlockHop = data
	if type(writefile) == 'function' then
		local okJson, body = pcall(function()
			return HttpService:JSONEncode(data)
		end)
		if okJson and type(body) == 'string' then
			pcall(writefile, hopPath(), body)
		end
	end
end

local function hopInProgress()
	local hop = readHop()
	return type(hop) == 'table'
		and hop.active == true
		and (hop.phase == 'f1' or hop.phase == 'f11' or hop.phase == 'fresh')
end

local function httpGet(url)
	local request = (syn and syn.request)
		or (http and http.request)
		or http_request
		or request
	if type(request) == 'function' then
		local ok, res = pcall(function()
			return request({ Url = url, Method = 'GET' })
		end)
		if ok and type(res) == 'table' and type(res.Body) == 'string' then
			return res.Body
		end
	end
	return game:HttpGet(url)
end

local function readFreshFinder()
	local fsf = getgenv().SB2FreshServerFinder
	if type(fsf) == 'table' then
		return fsf
	end
	local path = FOLDER .. '/fresh_server_finder.json'
	if type(isfile) == 'function' and type(readfile) == 'function' then
		local ok, exists = pcall(isfile, path)
		if ok and exists then
			local okRead, body = pcall(readfile, path)
			if okRead and type(body) == 'string' and body ~= '' then
				local okJson, data = pcall(function()
					return HttpService:JSONDecode(body)
				end)
				if okJson and type(data) == 'table' then
					getgenv().SB2FreshServerFinder = data
					return data
				end
			end
		end
	end
	return nil
end

local function writeFreshFinder(data)
	if type(data) ~= 'table' then
		data = { active = false }
	end
	getgenv().SB2FreshServerFinder = data
	if type(getgenv().SB2WriteFreshServerFinder) == 'function' then
		pcall(getgenv().SB2WriteFreshServerFinder, data)
		return
	end
	if type(writefile) ~= 'function' then
		return
	end
	ensureFolder()
	local okJson, body = pcall(function()
		return HttpService:JSONEncode(data)
	end)
	if okJson and type(body) == 'string' then
		pcall(writefile, FOLDER .. '/fresh_server_finder.json', body)
	end
end

local function freshFinderActive()
	local fsf = readFreshFinder()
	return type(fsf) == 'table' and fsf.active == true
end

local function ensureServerHopCatalog()
	if type(getgenv().SB2EnsureServerHopCatalog) == 'function' then
		local ok, cat = pcall(getgenv().SB2EnsureServerHopCatalog)
		if ok and type(cat) == 'table' then
			return cat
		end
	end
	local cat = getgenv().SB2ServerHopCatalog
	return type(cat) == 'table' and cat or nil
end

local function buildFreshFinderFloorList()
	local out = {}
	local cat = ensureServerHopCatalog()
	local storyPlaces = {}

	if type(cat) == 'table' then
		if type(cat.floors) == 'table' then
			for i, rec in ipairs(cat.floors) do
				if type(rec) == 'table' and tonumber(rec.placeId) then
					storyPlaces[rec.placeId] = true
					local f = tonumber(rec.floor) or i
					out[#out + 1] = {
						placeId = rec.placeId,
						name = rec.name,
						floor = f,
						category = rec.category or 'Main',
						label = ('F%d %s'):format(f, tostring(rec.name)),
						sortKey = string.format('%04d_%s', f, tostring(rec.name)),
					}
				end
			end
		end
		if type(cat.all) == 'table' then
			for _, rec in ipairs(cat.all) do
				if type(rec) == 'table' and tonumber(rec.placeId) and not storyPlaces[rec.placeId] then
					local catStr = tostring(rec.category or '')
					local label = tostring(rec.name or ('Place ' .. tostring(rec.placeId)))
					if catStr ~= '' then
						label = label .. ' [' .. catStr .. ']'
					end
					out[#out + 1] = {
						placeId = rec.placeId,
						name = rec.name,
						category = catStr,
						label = label,
						sortKey = 'z_' .. catStr .. '_' .. label,
					}
				end
			end
		end
	end

	if #out == 0 then
		for _, rec in ipairs(HARD_STORY_FLOORS) do
			out[#out + 1] = {
				placeId = rec.placeId,
				name = rec.name,
				floor = rec.floor,
				category = 'Main',
				label = ('F%d %s'):format(rec.floor, rec.name),
				sortKey = string.format('%04d_%s', rec.floor, rec.name),
			}
		end
	end

	table.sort(out, function(a, b)
		return tostring(a.sortKey) < tostring(b.sortKey)
	end)
	return out
end

local function getFloorCatalog()
	local cat = ensureServerHopCatalog()
	if type(cat) == 'table' and type(cat.all) == 'table' and #cat.all > 0 then
		return cat.all
	end
	return HARD_STORY_FLOORS
end

local function resolveFloorTarget(raw)
	if raw == nil or tostring(raw) == '' then
		return nil
	end
	if type(getgenv().SB2ServerHopResolveTarget) == 'function' then
		local ok, rec = pcall(getgenv().SB2ServerHopResolveTarget, raw)
		if ok and type(rec) == 'table' and rec.placeId then
			return rec
		end
	end
	local rawStr = tostring(raw)
	for _, rec in ipairs(buildFreshFinderFloorList()) do
		if rec.label and rec.label == rawStr then
			return rec
		end
	end
	local key = string.lower(rawStr:gsub('^%s+', ''):gsub('%s+$', ''))
	local flead = key:match('^(f%d+)')
	if flead then
		key = flead
	end
	local cat = ensureServerHopCatalog()
	if type(cat) == 'table' and type(cat.byAlias) == 'table' then
		local rec = cat.byAlias[key] or cat.byAlias[key:gsub('%W', '')]
		if rec then
			return rec
		end
	end
	local fnum = key:match('^f%-?(%d+)$') or key:match('^floor%-?(%d+)$') or key:match('^floor%s+(%d+)$')
	if fnum and type(cat) == 'table' and type(cat.floors) == 'table' then
		local rec = cat.floors[tonumber(fnum)]
		if rec then
			return rec
		end
	end
	for _, rec in ipairs(getFloorCatalog()) do
		local name = string.lower(tostring(rec.name or ''))
		if key == name or key == name:gsub('%W', '') then
			return rec
		end
		if tonumber(key) == tonumber(rec.placeId) then
			return rec
		end
	end
	return nil
end

local function readFreshFinderFloorPref()
	local fsf = readFreshFinder()
	if type(fsf) == 'table' and tonumber(fsf.placeId) then
		return tonumber(fsf.placeId), fsf.placeName
	end
	if type(isfile) == 'function' and type(readfile) == 'function' then
		local ok, exists = pcall(isfile, FRESH_FLOOR_PATH)
		if ok and exists then
			local okRead, body = pcall(readfile, FRESH_FLOOR_PATH)
			if okRead and type(body) == 'string' and body ~= '' then
				local okJson, data = pcall(function()
					return HttpService:JSONDecode(body)
				end)
				if okJson and type(data) == 'table' and tonumber(data.placeId) then
					return tonumber(data.placeId), data.placeName
				end
			end
		end
	end
	return tonumber(game.PlaceId) or game.PlaceId, nil
end

local function writeFreshFinderFloorPref(placeId, placeName)
	placeId = tonumber(placeId)
	if not placeId then
		return
	end
	ensureFolder()
	local payload = { placeId = placeId, placeName = placeName, t = os.time() }
	if type(writefile) == 'function' then
		local okJson, body = pcall(function()
			return HttpService:JSONEncode(payload)
		end)
		if okJson and type(body) == 'string' then
			pcall(writefile, FRESH_FLOOR_PATH, body)
		end
	end
	local fsf = readFreshFinder()
	if type(fsf) == 'table' then
		fsf.placeId = placeId
		fsf.placeName = placeName
		writeFreshFinder(fsf)
	end
end

local function setFreshFinderFloor(raw)
	local rec = resolveFloorTarget(raw)
	if not rec or not rec.placeId then
		return false, 'unknown floor'
	end
	writeFreshFinderFloorPref(rec.placeId, rec.name)
	local label = rec.floor and ('F' .. rec.floor .. ' ' .. rec.name) or rec.name
	return true, label
end

local freshHopBusy = false
local runAutoBlockSequence
local blockRetryToken = 0

local function bumpFreshFinderCancel()
	getgenv().SB2FreshFinderCancelGen = (getgenv().SB2FreshFinderCancelGen or 0) + 1
	blockRetryToken += 1
	freshHopBusy = false
end

local function freshFinderCancelled(sinceGen)
	if (getgenv().SB2FreshFinderCancelGen or 0) ~= (sinceGen or 0) then
		return true
	end
	return not freshFinderActive()
end

local function pickFreshServerJob(placeId, triedSet)
	-- Only empty public instances count as "fresh". Never hop into an already
	-- populated server just because it has fewer players — that cycles the list.
	triedSet = triedSet or {}
	local current = tostring(game.JobId or '')
	if current ~= '' then
		triedSet[current] = true
	end
	local cursor = ''
	for _ = 1, 8 do
		local url = ('https://games.roblox.com/v1/games/%d/servers/Public?sortOrder=Asc&limit=100'):format(placeId)
		if cursor ~= '' then
			local enc = cursor
			pcall(function()
				enc = HttpService:UrlEncode(cursor)
			end)
			url = url .. '&cursor=' .. enc
		end
		local ok, body = pcall(httpGet, url)
		if not ok or type(body) ~= 'string' or body == '' then
			break
		end
		local okJson, data = pcall(function()
			return HttpService:JSONDecode(body)
		end)
		if not okJson or type(data) ~= 'table' or type(data.data) ~= 'table' then
			break
		end
		for _, srv in ipairs(data.data) do
			local id = tostring(srv.id or '')
			local playing = tonumber(srv.playing) or 0
			if id ~= '' and not triedSet[id] and playing <= 0 then
				return id, triedSet
			end
		end
		cursor = data.nextPageCursor
		if type(cursor) ~= 'string' or cursor == '' then
			break
		end
	end
	return nil, triedSet
end

local function autoblockShouldRun()
	return enabled or freshFinderActive()
end

local function armTeleport()
	getgenv().SB2AutoBlockHopping = true
	if type(getgenv().SB2CloseAllPillPanels) == 'function' then
		pcall(getgenv().SB2CloseAllPillPanels)
	end
	if type(getgenv().SB2PlayerToolsArmTeleport) == 'function' then
		pcall(getgenv().SB2PlayerToolsArmTeleport)
	elseif type(queueteleport) == 'function' then
		-- Keep PlayerTools across the hop even if PT hasn't loaded yet.
		pcall(queueteleport, [[
if isfile and isfile('PlayerTools/manual_unload') then local ok,b=pcall(readfile,'PlayerTools/manual_unload'); if ok and tostring(b)=='true' then return end end
if getgenv().SB2PlayerToolsManualUnload then return end
getgenv().SB2MenuHopGraceUntil=os.clock()+25;getgenv().SB2UiKeeperQuietUntil=os.clock()+25;getgenv().SB2MenuWantOpen=true
local function soft() local gui=getgenv().SB2PlayerToolsGui; if typeof(gui)~='Instance' then return false end
if not gui.Parent then pcall(function() local h=nil; if gethui then local ok,x=pcall(gethui); if ok then h=x end end; local cg=game:FindService('CoreGui') or game:GetService('CoreGui'); gui.Parent=h or (cg and cg:FindFirstChild('RobloxGui')) or cg; if not gui.Parent then local lp=game:GetService('Players').LocalPlayer; local pg=lp and lp:FindFirstChildOfClass('PlayerGui'); if pg then gui.Parent=pg end end; if gui.Parent then gui.Enabled=true end end) end
if not gui.Parent then return false end; getgenv().SB2PlayerTools=true; getgenv().SB2UiOrphanFails=0; if type(getgenv().SB2RefreshPlayerTools)=='function' then pcall(getgenv().SB2RefreshPlayerTools) end; return true end
if soft() then return end
if getgenv().SB2PlayerToolsLoading==true then for _=1,50 do task.wait(0.4); if getgenv().SB2PlayerToolsManualUnload then return end; if soft() then return end; if getgenv().SB2PlayerToolsLoading~=true then break end end; if soft() then return end end
for _=1,10 do task.wait(0.4); if soft() then return end end
if getgenv().SB2PlayerToolsLoading==true then return end
