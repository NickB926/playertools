if fn then pcall(fn) else getgenv().SB2PlayerToolsLoading=false; getgenv().SB2SoftPlayerToolsReload=nil end
]])
	end
end

local function startFreshServerHop(reason)
	local fresh = freshFinderActive()
	if not fresh then
		return false
	end
	if stopFreshFinderIfEmpty('Empty server found on this floor') then
		return false
	end
	if freshHopBusy then
		return false
	end
	local cancelGen = getgenv().SB2FreshFinderCancelGen or 0
	-- Fresh finder needs transient block runs without flipping the user's autoblock toggle.
	local placeId = tonumber(game.PlaceId) or game.PlaceId
	local fsf = readFreshFinder() or { active = true, placeId = placeId, tried = {}, hops = 0 }
	if fsf.active ~= true then
		return false
	end
	fsf.placeId = tonumber(fsf.placeId) or placeId
	fsf.tried = type(fsf.tried) == 'table' and fsf.tried or {}
	fsf.hops = (tonumber(fsf.hops) or 0) + 1
	if fsf.hops > 60 then
		fsf.active = false
		writeFreshFinder(fsf)
		writeHop({ active = false, phase = 'off' })
		getgenv().SB2AutoBlockHopping = nil
		say('fresh server finder stopped — 60 hops')
		return false
	end
	writeFreshFinder(fsf)
	writeHop({ active = true, phase = 'fresh', placeId = fsf.placeId, auto = true })
	armTeleport()
	getgenv().SB2AutoBlockHopping = true
	markJustLanded(14) -- for the destination session after teleport
	local label = reason or ('fresh hop #' .. tostring(fsf.hops))
	local hopNum = fsf.hops
	freshHopBusy = true
	task.spawn(function()
		if freshFinderCancelled(cancelGen) then
			freshHopBusy = false
			return
		end
		task.wait(0.35)
		if freshFinderCancelled(cancelGen) then
			freshHopBusy = false
			return
		end
		task.wait(BLOCK_SETTLE_SEC)
		if freshFinderCancelled(cancelGen) then
			freshHopBusy = false
			return
		end
		if stopFreshFinderIfEmpty('Empty server found on this floor') then
			freshHopBusy = false
			return
		end
		local hopPlace = tonumber(game.PlaceId) or fsf.placeId
		fsf.placeId = hopPlace
		writeFreshFinder(fsf)
		local teleported = false
		-- Private reserve = empty server, same floor, no HTTP scrape.
		local okReserve, reserveCode = pcall(function()
			return TeleportService:ReserveServer(hopPlace)
		end)
		if okReserve and type(reserveCode) == 'string' and reserveCode ~= '' then
			say(label .. ' → reserved server…')
			teleported = pcall(function()
				TeleportService:TeleportToPrivateServer(hopPlace, reserveCode, { LocalPlayer })
			end)
		end
		if not teleported then
			local jobId
			jobId, fsf.tried = pickFreshServerJob(hopPlace, fsf.tried)
			if freshFinderCancelled(cancelGen) then
				freshHopBusy = false
				return
			end
			writeFreshFinder(fsf)
			local currentJob = tostring(game.JobId or '')
			if jobId and jobId == currentJob then
				jobId = nil
			end
			if jobId then
				fsf.tried[jobId] = true
				writeFreshFinder(fsf)
				say(label .. ' → empty public server ' .. string.sub(jobId, 1, 8) .. '…')
				teleported = pcall(function()
					TeleportService:TeleportToPlaceInstance(hopPlace, jobId, LocalPlayer)
				end)
			end
		end
		if not teleported then
			-- No reserved/empty listed instance — matchmake (may spin a new server).
			-- Do NOT scrape low-pop occupied servers; that just cycles the list.
			say(label .. ' → matchmaking for a new server…')
			pcall(function()
				TeleportService:Teleport(hopPlace, LocalPlayer)
			end)
		end
		task.delay(2, function()
			freshHopBusy = false
		end)
	end)
	return true
end

getgenv().SB2StartFreshServerHop = startFreshServerHop

-- Fresh finder: strangers present but all already blocked → hop same floor.
local function hopFreshIfNoUnblocked(reason)
	local fresh = freshFinderActive()
	local actionable = countActionableStrangers()
	local strangers = countStrangerPlayers()
	if not fresh then
		return false
	end
	if actionable > 0 then
		return false
	end
	-- Empty server is the goal — never hop away from zero strangers.
	if strangers == 0 then
		return stopFreshFinderIfEmpty(reason or 'Empty server found on this floor')
	end
	if stopFreshFinderIfEmpty('Empty server found on this floor') then
		return true
	end
	say(reason or 'all present already blocked — hopping…')
	local ok = startFreshServerHop(reason or 'all present already blocked — hopping…')
	return ok
end
getgenv().SB2HopFreshIfNoUnblocked = hopFreshIfNoUnblocked

local function startSameFloorHop(reason)
	if enabled then
		writeFile(true)
	end
	getgenv().SB2AutoBlockWanted = autoblockShouldRun()
	local placeId = tonumber(game.PlaceId) or game.PlaceId
	writeHop({ active = true, phase = 'fresh', placeId = placeId, auto = true })
	armTeleport()
	getgenv().SB2AutoBlockHopping = true
	markJustLanded(14)
	say(reason or 'hopping this floor…')
	task.spawn(function()
		local teleported = false
		local okReserve, code = pcall(function()
			return TeleportService:ReserveServer(placeId)
		end)
		if okReserve and type(code) == 'string' and code ~= '' then
			say((reason or 'hop') .. ' → reserved server…')
			teleported = pcall(function()
				TeleportService:TeleportToPrivateServer(placeId, code, { LocalPlayer })
			end)
		end
		if not teleported then
			say((reason or 'hop') .. ' → random server on this floor')
			pcall(function()
				TeleportService:Teleport(placeId, LocalPlayer)
			end)
		end
	end)
	return true
end

-- Legacy name — always hops current floor (never F11-only).
local function startF11Hop(reason)
	return startSameFloorHop(reason)
end

-- ---- CoreGui Block prompt helpers (ported from PlayerTools) ----
local function coreGui()
	local cg = game:GetService('CoreGui')
	if cloneref then
		pcall(function()
			cg = cloneref(cg)
		end)
	end
	return cg
end

local function coreGuiRoots()
	local roots = {}
	local seen = {}
	local function add(r)
		if r and not seen[r] then
			seen[r] = true
			roots[#roots + 1] = r
		end
	end
	-- Raw CoreGui first — cloneref sometimes hides Foundation overlay kids.
	pcall(function()
		add(game:GetService('CoreGui'))
	end)
	pcall(function()
		add(coreGui())
	end)
	pcall(function()
		if type(gethui) == 'function' then
			add(gethui())
		end
	end)
	return roots
end

local function buttonPlainText(obj)
	local text = ''
	pcall(function()
		text = tostring(obj.Text or '')
	end)
	if text == '' then
		pcall(function()
			text = tostring(obj.ContentText or '')
		end)
	end
	text = text:gsub('%b<>', '')
	return (string.lower(text):gsub('^%s+', ''):gsub('%s+$', ''))
end

local function findBlockingModal()
	-- FindFirstChild on FoundationOverlay often returns nil even when the modal is open.
	for _, root in ipairs(coreGuiRoots()) do
		local ok, descendants = pcall(function()
			return root:GetDescendants()
		end)
		if ok and type(descendants) == 'table' then
			for _, d in ipairs(descendants) do
				if d.Name == 'BlockingModalScreen' and not d:IsA('LuaSourceContainer') then
					local path = ''
					pcall(function()
						path = string.lower(d:GetFullName())
					end)
					if path:find('foundationoverlay', 1, true) or path:find('safeareaframe', 1, true) then
						return d
					end
					if not path:find('modules.settings', 1, true) and (d:IsA('GuiObject') or d:IsA('Folder')) then
						return d
					end
				end
			end
		end
	end
	return nil
end

-- Live Block row = FoundationOverlay ... Footer.Buttons.N (ImageButton).
local function findModalBlockButton()
	local cam = workspace.CurrentCamera
	local vp = cam and cam.ViewportSize or Vector2.new(1920, 1080)
	local best
	local bestScore = -math.huge

	local function scoreCandidate(pick, path)
		if not pick or not pick:IsA('GuiObject') then
			return
		end
		local ps = pick.AbsoluteSize
		if ps.X < 40 or ps.Y < 16 then
			return
		end
		if ps.Y > 96 or ps.X > vp.X * 0.85 then
			return
		end
		if ps.X > vp.X * 0.7 and ps.Y > vp.Y * 0.2 then
			return
		end
		local cy = pick.AbsolutePosition.Y + ps.Y * 0.5
		if cy < vp.Y * 0.35 then
			return
		end
		local score = 0
		if path:find('footer', 1, true) then
			score += 80
		end
		if path:find('buttons', 1, true) then
			score += 40
		end
		if pick.Name:match('^%d+$') then
			score += 25
		end
		if pick:IsA('GuiButton') then
			score += 20
		end
		if ps.Y >= 28 and ps.Y <= 64 then
			score += 30
		elseif ps.Y <= 80 then
			score += 10
		end
		score += math.min(40, (cy / vp.Y) * 40)
		if path:find('footer', 1, true) then
			score -= (cy / vp.Y) * 8
		end
		score -= ps.Y * 0.15
		if score > bestScore then
			bestScore = score
			best = pick
		end
	end

	local function buttonHasExactBlock(btn)
		local hasBlock = false
		local hasReport = false
		local function check(obj)
			local t = buttonPlainText(obj)
			if t == 'block' then
				hasBlock = true
			elseif t:find('report', 1, true) then
				hasReport = true
			end
		end
		check(btn)
		for _, c in ipairs(btn:GetDescendants()) do
			if c:IsA('TextLabel') or c:IsA('TextButton') then
				check(c)
			end
		end
		return hasBlock and not hasReport
	end

	for _, root in ipairs(coreGuiRoots()) do
		pcall(function()
			for _, d in ipairs(root:GetDescendants()) do
				if d:IsA('ImageButton') or d:IsA('TextButton') then
					local path = string.lower(d:GetFullName())
					if path:find('joinlogs', 1, true) or path:find('playertools', 1, true) then
						continue
					end
					if not (path:find('foundationoverlay', 1, true) or path:find('blockingmodal', 1, true)) then
						continue
					end
					if path:find('report', 1, true) then
						continue
					end
					if buttonHasExactBlock(d) then
						scoreCandidate(d, path)
					end
				end
			end
		end)
	end

	if best then
		return best
	end

	for _, root in ipairs(coreGuiRoots()) do
		pcall(function()
			for _, label in ipairs(root:GetDescendants()) do
				if label:IsA('TextLabel') or label:IsA('TextButton') then
					if buttonPlainText(label) ~= 'block' then
						continue
					end
					local path = string.lower(label:GetFullName())
					if path:find('joinlogs', 1, true) or path:find('playertools', 1, true) then
						continue
					end
					if path:find('report', 1, true) then
						continue
					end
					if not (path:find('foundationoverlay', 1, true) or path:find('blockingmodal', 1, true)) then
						continue
					end
					local pick = label
					local p = label.Parent
					for _ = 1, 6 do
						if not p then
							break
						end
						if p:IsA('GuiButton') then
							pick = p
							break
						end
						p = p.Parent
					end
					scoreCandidate(pick, path)
				end
			end
		end)
	end
	return best
end

local function blockAimPoints(btn)
	if not btn or not btn:IsA('GuiObject') then
		return {}
	end
	local pos = btn.AbsolutePosition
	local size = btn.AbsoluteSize
	if size.X < 2 or size.Y < 2 then
		return {}
	end
	local inset = Vector2.zero
	pcall(function()
		inset = GuiService:GetGuiInset()
	end)
	local cx = pos.X + size.X * 0.5
	local cy = pos.Y + size.Y * 0.55
	local points = {
		{ x = cx + inset.X, y = cy + inset.Y, tag = 'abs+inset' },
		{ x = cx + inset.X, y = pos.Y + size.Y * 0.72 + inset.Y, tag = 'low+inset' },
		{ x = cx + inset.X, y = pos.Y + size.Y - 4 + inset.Y, tag = 'bot+inset' },
	}
	points[#points + 1] = { x = cx, y = cy, tag = 'abs' }
	points[#points + 1] = { x = cx, y = cy + 53, tag = 'abs+53' }
	return points
end

local function focusThisClient()
	pcall(function()
		local cam = workspace.CurrentCamera
		local vs = cam and cam.ViewportSize
		local fx = vs and (vs.X * 0.5) or 400
		local fy = vs and math.min(40, vs.Y * 0.05) or 20
		if type(mousemoveabs) == 'function' then
			mousemoveabs(fx, fy)
		else
			VirtualInputManager:SendMouseMoveEvent(fx, fy, game)
		end
		if type(mouse1click) == 'function' then
			mouse1click()
		else
			VirtualInputManager:SendMouseButtonEvent(fx, fy, 0, true, game, 1)
			VirtualInputManager:SendMouseButtonEvent(fx, fy, 0, false, game, 1)
		end
	end)
	task.wait(0.05)
end

local function blockClickCoords(btn)
	local cam = workspace.CurrentCamera
	local vs = cam and cam.ViewportSize or Vector2.new(1600, 877)
	local points = blockAimPoints(btn)
	if points[1] then
		return points[1].x, points[1].y, points[1].tag
	end
	return vs.X * 0.5056, vs.Y * 0.5450, 'norm'
end

local function fireGuiClick(btn)
	if not btn then
		return
	end
	local target = btn
	if not target:IsA('GuiButton') and target.Parent and target.Parent:IsA('GuiButton') then
		target = target.Parent
	end
	pcall(function()
		local p = target
		for _ = 1, 6 do
			if not p then
				break
			end
			if p:IsA('ImageButton') or p:IsA('TextButton') then
				target = p
				break
			end
			p = p.Parent
		end
	end)
	if not target:IsA('GuiButton') then
		return
	end
	pcall(function()
		if typeof(target.Activate) == 'function' then
			target:Activate()
		end
	end)
	pcall(function()
		if type(firesignal) == 'function' then
			pcall(firesignal, target.Activated)
			pcall(firesignal, target.MouseButton1Click)
			pcall(firesignal, target.MouseButton1Down)
			pcall(firesignal, target.MouseButton1Up)
		end
	end)
	pcall(function()
		if type(getconnections) ~= 'function' then
			return
		end
		for _, sig in ipairs({ 'Activated', 'MouseButton1Click', 'MouseButton1Down', 'MouseButton1Up' }) do
			local ok, cons = pcall(getconnections, target[sig])
			if ok and type(cons) == 'table' then
				for _, c in ipairs(cons) do
					pcall(function()
						if c.Fire then
							c:Fire()
						elseif c.fire then
							c:fire()
						end
					end)
				end
			end
		end
	end)
end

local function moveAndClickAt(gx, gy)
	pcall(function()
		if type(mousemoveabs) == 'function' then
			mousemoveabs(gx, gy)
		end
	end)
	pcall(function()
		VirtualInputManager:SendMouseMoveEvent(gx, gy, game)
	end)
	task.wait(0.12)
	pcall(function()
		if type(mouse1press) == 'function' and type(mouse1release) == 'function' then
			mouse1press()
			task.wait(0.07)
			mouse1release()
		elseif type(mouse1click) == 'function' then
			mouse1click()
		end
	end)
	pcall(function()
		VirtualInputManager:SendMouseMoveEvent(gx, gy, game)
		VirtualInputManager:SendMouseButtonEvent(gx, gy, 0, true, game, 1)
		task.wait(0.07)
		VirtualInputManager:SendMouseButtonEvent(gx, gy, 0, false, game, 1)
	end)
end

local function modalStillUp()
	return findBlockingModal() ~= nil
end

local function alreadyBlockedUi()
	for _, root in ipairs(coreGuiRoots()) do
		local ok, hit = pcall(function()
			for _, d in ipairs(root:GetDescendants()) do
				if d:IsA('TextLabel') or d:IsA('TextButton') or d:IsA('TextBox') then
					local t = buttonPlainText(d)
					if t == 'unblock' then
						local path = string.lower(d:GetFullName())
						if path:find('joinlogs', 1, true)
							or path:find('playertools', 1, true)
							or path:find('modules.settings', 1, true)
						then
							continue
						end
						return true
					end
				end
			end
			return false
		end)
		if ok and hit then
			return true
		end
	end
	return false
end

local function waitForBlockModal(timeoutSec)
	local untilT = os.clock() + (tonumber(timeoutSec) or 2.5)
	while os.clock() < untilT do
		if findBlockingModal() or findModalBlockButton() then
			return true
		end
		task.wait(0.2)
	end
	return modalStillUp()
end

local function waitForBlockedUi(timeoutSec)
	local untilT = os.clock() + (tonumber(timeoutSec) or 2.5)
	while os.clock() < untilT do
		if alreadyBlockedUi() then
			return true
		end
		task.wait(0.15)
	end
	return alreadyBlockedUi()
end

local function sendNavKey(keyCode)
	pcall(function()
		VirtualInputManager:SendKeyEvent(true, keyCode, false, game)
		task.wait(0.04)
		VirtualInputManager:SendKeyEvent(false, keyCode, false, game)
	end)
end

local function gentleBlockClick(btn)
	btn = findModalBlockButton() or btn
	if not btn then
		return false
	end
	local target = btn
	if not target:IsA('GuiButton') and target.Parent and target.Parent:IsA('GuiButton') then
		target = target.Parent
	end

	-- Navigation UI: move selection to Block, then Enter (Cancel is default focus).
	pcall(function()
		GuiService.SelectedObject = target
	end)
	task.wait(0.08)
	local selText = ''
	pcall(function()
		local sel = GuiService.SelectedObject
		if sel then
			selText = buttonPlainText(sel)
		end
	end)
	if selText:find('cancel', 1, true) or selText:find('report', 1, true) or selText == '' then
		sendNavKey(Enum.KeyCode.Up)
		task.wait(0.06)
		sendNavKey(Enum.KeyCode.Up)
		task.wait(0.06)
		pcall(function()
			GuiService.SelectedObject = target
		end)
		task.wait(0.08)
	end
	sendNavKey(Enum.KeyCode.Return)
	task.wait(0.35)
	if not modalStillUp() then
		return true
	end

	-- Fallback: single Activate (avoid multi-fire "Something went wrong").
	pcall(function()
		if typeof(target.Activate) == 'function' then
			target:Activate()
		end
	end)
	task.wait(0.55)
	return not modalStillUp()
end

local function clickBlockWithMouse(btn, useOsMouse)
	btn = findModalBlockButton() or btn
	if gentleBlockClick(btn) then
		return true
	end
	btn = findModalBlockButton() or btn
	if not btn then
		return not modalStillUp()
	end
	if useOsMouse == false then
		return not modalStillUp()
	end
	focusThisClient()
	local points = blockAimPoints(btn)
	if #points == 0 then
		local x, y = blockClickCoords(btn)
		points = { { x = x, y = y, tag = 'norm' } }
	end
	if points[1] then
		moveAndClickAt(points[1].x, points[1].y)
		task.wait(0.45)
	end
	local closed = not modalStillUp()
	return closed
end

-- ---- Watch / timers ----
local enabled = false
local autoTimers = {}
local autoBusy = false
local autoEpoch = 0
local justLandedUntil = 0
local statusText = 'off'
local conns = {}

local function setStatus(text)
	statusText = tostring(text or 'off')
	getgenv().SB2AutoBlockStatus = statusText
	if type(getgenv().SB2AutoBlockPaint) == 'function' then
		pcall(getgenv().SB2AutoBlockPaint)
	end
end

local function cancelAutoTimer(userId)
	userId = tonumber(userId)
	if not userId then
		return
	end
	local rec = autoTimers[userId]
	if rec then
		rec.cancelled = true
		autoTimers[userId] = nil
	end
end

local function cancelAllAutoTimers()
	for userId, rec in pairs(autoTimers) do
		if rec then
			rec.cancelled = true
		end
		autoTimers[userId] = nil
	end
end

local function finishHop(plr, reason, opts)
	opts = type(opts) == 'table' and opts or {}
	local freshNow = freshFinderActive()
	if opts.fromFreshFinder == true and not freshNow then
		return false
	end
	if plr and plr.UserId and opts.allowFreshHop == true then
		markSkipBlocked(plr, 300)
		getgenv().SB2FreshBlockRetries = getgenv().SB2FreshBlockRetries or {}
		getgenv().SB2FreshBlockRetries[plr.UserId] = nil
	end
	if freshFinderActive() and opts.allowFreshHop ~= true then
		local retries = getgenv().SB2FreshBlockRetries or {}
		local n = (tonumber(retries[plr and plr.UserId]) or 0) + 1
		retries[plr and plr.UserId] = n
		getgenv().SB2FreshBlockRetries = retries
		if n >= 2 then
			say(('fresh finder — hop anyway after %d tries (%s)'):format(
				n,
				tostring(plr and (plr.DisplayName or plr.Name) or '?')
			))
			opts.allowFreshHop = true
		else
			local myToken = blockRetryToken
			say(reason or 'fresh finder — retry block…')
			task.delay(1.5, function()
				if blockRetryToken ~= myToken or freshFinderCancelled(getgenv().SB2FreshFinderCancelGen or 0) then
					return
				end
				if not enabled and not freshFinderActive() then
					return
				end
				if plr and Players:GetPlayerByUserId(plr.UserId) then
					runAutoBlockSequence(plr)
				else
					armPresent(0)
				end
			end)
			return false
		end
	end
	cancelAllAutoTimers()
	local wantFreshHop = freshNow
		or opts.fromFreshFinder == true
		or (opts.allowFreshHop == true and freshFinderActive())
	if wantFreshHop then
		local ok = startFreshServerHop(reason)
		if not ok and wantFreshHop and opts.allowFreshHop == true then
			-- Prefer PlayerTools fallback, then same-floor hop.
			task.delay(0.5, function()
				if type(getgenv().SB2HopCurrentFloorNow) == 'function' then
					pcall(getgenv().SB2HopCurrentFloorNow, reason .. ' (pt fallback)')
					return
				end
				if not freshFinderActive() then
					return
				end
				if freshHopBusy or hopInProgress() then
					return
				end
				startFreshServerHop(reason .. ' (retry)')
			end)
			-- Last resort: hop this PlaceId even if fresh-finder state raced off.
			return startSameFloorHop(reason)
		end
		return ok
	end
	return startSameFloorHop(reason)
end

runAutoBlockSequence = function(plr)
	if autoBusy or not plr or plr == LocalPlayer or isOwnAlt(plr) then
		return
	end
	if not Players:GetPlayerByUserId(plr.UserId) then
		return
	end
	local forFreshFinder = freshFinderActive()
	if not forFreshFinder and not enabled then
		return
	end
	local cancelGen = getgenv().SB2FreshFinderCancelGen or 0
	local function cancelled()
		return freshFinderCancelled(cancelGen)
	end
	if isKnownBlocked(plr) then
		if forFreshFinder then
			if hopFreshIfNoUnblocked(('already blocked %s — hopping…'):format(tostring(plr.DisplayName or plr.Name))) then
				return
			end
			finishHop(plr, ('already blocked %s — hopping…'):format(tostring(plr.DisplayName or plr.Name)), {
				allowFreshHop = true,
				fromFreshFinder = forFreshFinder,
			})
		end
		return
	end
	autoBusy = true
	getgenv().SB2AutoBlockBusy = true
	setStatus('blocking ' .. tostring(plr.DisplayName or plr.Name))
	say(('blocking %s'):format(tostring(plr.DisplayName or plr.Name)))
	task.spawn(function()
		local okRun, errRun = xpcall(function()
			if cancelled() then
				return
			end
			task.wait(ACTION_DELAY)
			if cancelled() or not Players:GetPlayerByUserId(plr.UserId) then
				return
			end
			if alreadyBlockedUi() then
				markConfirmedBlocked(plr, 300)
				finishHop(plr, ('%s already blocked — hopping…'):format(tostring(plr.DisplayName or plr.Name)), {
					allowFreshHop = true,
					fromFreshFinder = forFreshFinder,
				})
				return
			end
			if type(getgenv().SB2CloseAllPillPanels) == 'function' then
				pcall(getgenv().SB2CloseAllPillPanels)
			end
			task.wait(0.15)
			local promptOk = pcall(function()
				StarterGui:SetCore('PromptBlockPlayer', plr)
			end)
			if not promptOk then
				task.wait(0.5)
				promptOk = pcall(function()
					StarterGui:SetCore('PromptBlockPlayer', plr)
				end)
			end
			if not promptOk then
				markSkipBlocked(plr, 45)
				finishHop(
					plr,
					('block prompt failed for %s'):format(tostring(plr.DisplayName or plr.Name)),
					{ allowFreshHop = true, fromFreshFinder = forFreshFinder }
				)
				return
			end
			say('waiting for Block menu…')
			local sawModal = waitForBlockModal(2.5)
			if waitForBlockedUi(1.5) then
				markConfirmedBlocked(plr, 86400)
				finishHop(plr, ('%s already blocked — hopping…'):format(tostring(plr.DisplayName or plr.Name)), {
					allowFreshHop = true,
					fromFreshFinder = forFreshFinder,
				})
				return
			end
			if cancelled() then
				return
			end
			if alreadyBlockedUi() then
				markConfirmedBlocked(plr, 300)
				finishHop(plr, ('%s already blocked — hopping…'):format(tostring(plr.DisplayName or plr.Name)), {
					allowFreshHop = true,
					fromFreshFinder = forFreshFinder,
				})
				return
			end
			local btn = findModalBlockButton()
			if btn then
				gentleBlockClick(btn)
				task.wait(0.45)
				if modalStillUp() then
					clickBlockWithMouse(btn, true)
					task.wait(0.45)
				end
			elseif sawModal then
				task.wait(0.65)
			end
			local blocked = alreadyBlockedUi() or (sawModal and not modalStillUp())
			if cancelled() then
				return
			end
			if not enabled and not freshFinderActive() then
				return
			end
			if blocked then
				task.wait(BLOCK_SETTLE_SEC)
				markConfirmedBlocked(plr, 300)
				finishHop(plr, ('blocked %s — hopping same floor…'):format(tostring(plr.DisplayName or plr.Name)), {
					allowFreshHop = true,
					fromFreshFinder = forFreshFinder,
				})
				return
			end
			-- Fresh finder: confirm failed — short temp skip only (never persist).
			if forFreshFinder then
				markSkipBlocked(plr, 20)
				finishHop(
					plr,
					('no unblocked action for %s — hopping…'):format(tostring(plr.DisplayName or plr.Name)),
					{ allowFreshHop = true, fromFreshFinder = true }
				)
				return
			end
			finishHop(
				plr,
				('Block menu missing for %s'):format(tostring(plr.DisplayName or plr.Name)),
				{ allowFreshHop = false, fromFreshFinder = forFreshFinder }
			)
		end, debug.traceback)
		autoBusy = false
		getgenv().SB2AutoBlockBusy = false
		if not okRun then
			setStatus('error')
			say('error: ' .. tostring(errRun))
			if not cancelled() then
				finishHop(plr, ('error on %s — hopping anyway'):format(tostring(plr.DisplayName or plr.Name)), {
					allowFreshHop = true,
					fromFreshFinder = forFreshFinder,
				})
			end
		elseif enabled and not hopInProgress() then
			setStatus('watching')
		end
	end)
end

local function startAutoTimer(plr, waitSec, opts)
	opts = type(opts) == 'table' and opts or {}
	if not autoblockShouldRun() or not plr or plr == LocalPlayer or isOwnAlt(plr) then
		return
	end
	if isKnownBlocked(plr) then
		if freshFinderActive() then
			hopFreshIfNoUnblocked(('already blocked %s — hopping…'):format(tostring(plr.DisplayName or plr.Name)))
		end
		return
	end
	if hopInProgress() and game.PlaceId == F1_PLACE then
		return
	end
	local userId = plr.UserId
	waitSec = tonumber(waitSec)
	if waitSec == nil then
		waitSec = AUTO_BLOCK_WAIT
	end
	local immediate = waitSec <= 0.05
	if autoTimers[userId] then
		if not immediate then
			return
		end
		cancelAutoTimer(userId)
	end
	local epoch = autoEpoch
	local rec = {
		userId = userId,
		name = tostring(plr.DisplayName or plr.Name),
		deadline = os.clock() + math.max(0, waitSec),
		cancelled = false,
	}
	autoTimers[userId] = rec
	local function finishTimer()
		if rec.cancelled or autoTimers[userId] ~= rec or epoch ~= autoEpoch then
			return
		end
		autoTimers[userId] = nil
		local still = Players:GetPlayerByUserId(userId)
		if not still then
			setStatus(enabled and 'watching' or 'off')
			return
		end
		runAutoBlockSequence(still)
	end
	if immediate then
		if not opts.silent then
			say(('block now — %s (already here)'):format(rec.name))
		end
		setStatus('blocking now · ' .. rec.name)
		task.spawn(function()
			local spin = os.clock() + 20
			while autoBusy and os.clock() < spin do
				if rec.cancelled or autoTimers[userId] ~= rec then
					return
				end
				task.wait(0.15)
			end
			finishTimer()
		end)
		return
	end
	if not opts.silent then
		-- #region agent log
		agentLog('C', 'startAutoTimer', 'arming block timer', {
			waitSec = waitSec,
			enabled = enabled,
			freshActive = freshFinderActive(),
			name = rec.name,
		})
		-- #endregion
		say(('auto block in %ds — %s'):format(math.floor(waitSec + 0.5), rec.name))
	end
	setStatus(('%ds · %s'):format(math.ceil(waitSec), rec.name))
	task.spawn(function()
		while autoTimers[userId] == rec and not rec.cancelled and epoch == autoEpoch do
			local left = rec.deadline - os.clock()
			if left <= 0 then
				break
			end
			setStatus(('%ds · %s'):format(math.ceil(left), rec.name))
			task.wait(0.5)
		end
		finishTimer()
	end)
end

local function ensureFreshFinderWatchdog()
	if freshFinderWatchdogOn then
		return
	end
	freshFinderWatchdogOn = true
	task.spawn(function()
		while freshFinderActive() do
			task.wait(2.5)
			if not freshFinderActive() then
				break
			end
			local strangers = countStrangerPlayers()
			local actionable = countActionableStrangers()
			if strangers > 0 and actionable <= 0 and not autoBusy and getgenv().SB2AutoBlockBusy ~= true then
				-- #region agent log
				agentLog('D', 'watchdog', 'hop trigger', {
					strangers = strangers,
					actionable = actionable,
					autoBusy = autoBusy,
					sb2Busy = getgenv().SB2AutoBlockBusy,
				})
				-- #endregion
				hopFreshIfNoUnblocked('watchdog — all known blocked, hopping…')
			end
		end
		freshFinderWatchdogOn = false
	end)
end

-- Forward-declare: resumeFreshServerFinder runs at boot and must see the local,
-- not a nil global (Lua scope begins at the declaration line).
local setAutoBlockEnabled

local function resumeFreshServerFinder()
	if not freshFinderActive() then
		return
	end
	-- #region agent log
	agentLog('B', 'resumeFreshServerFinder', 'resume without toggling user autoblock', {
		enabled = enabled,
		userWanted = getgenv().SB2AutoBlockUserWanted,
		fileOn = fileOn(),
	})
	-- #endregion
	markJustLanded(14)
	ensureFreshFinderWatchdog()
	getgenv().SB2AutoBlockHopping = nil
	writeHop({ active = false, phase = 'off' })
	wireWatchers()
	ensurePresenceWatchdog()
	armPresent(0)
	say('fresh finder — re-armed after hop')
	task.spawn(function()
		-- Wait briefly for character / players, but keep arming the whole time.
		for i = 1, 40 do
			if not freshFinderActive() then
				return
			end
			local char = LocalPlayer.Character
			local hrp = char and (char:FindFirstChild('HumanoidRootPart') or char:FindFirstChild('Humanoid'))
			local strangers = countStrangerPlayers()
			if strangers > 0 then
				getgenv().SB2FreshEmptySince = nil
			end
			if i == 1 or i % 4 == 0 then
				pcall(armPresent, 0)
			end
			if type(getgenv().SB2FreshServerFinderTick) == 'function' then
				pcall(getgenv().SB2FreshServerFinderTick)
			end
			-- Only declare empty after landing grace + stable empty.
			if hrp and not stillLanding() then
				if stopFreshFinderIfEmpty('Empty server found on this floor') then
					return
				end
			end
			if strangers > 0 and hrp then
				-- Engaged — keep watchdog going; no need to spin forever here.
				if i >= 6 then
					return
				end
			end
			task.wait(0.35)
		end
		if freshFinderActive() then
			pcall(armPresent, 0)
		end
	end)
end

local function armPresent(waitSec)
	if not autoblockShouldRun() then
		return
	end
	if hopInProgress() and game.PlaceId == F1_PLACE then
		return
	end
	waitSec = tonumber(waitSec)
	if waitSec == nil then
		waitSec = (os.clock() < justLandedUntil) and 0 or AUTO_BLOCK_WAIT
	end
	if freshFinderActive() then
		waitSec = 0
	end
	local armed = 0
	local skipped = 0
	for _, plr in ipairs(Players:GetPlayers()) do
		if plr ~= LocalPlayer and not isOwnAlt(plr) then
			if isKnownBlocked(plr) then
				skipped += 1
			else
				startAutoTimer(plr, waitSec, { silent = waitSec <= 0.05 })
				armed += 1
			end
		end
	end
	-- Fresh finder: everyone here is already blocked → hop same floor (not when empty).
	if armed == 0 and freshFinderActive() then
		if countStrangerPlayers() == 0 then
			stopFreshFinderIfEmpty('Empty server found on this floor')
		else
			hopFreshIfNoUnblocked('no unblocked players here — hopping…')
		end
	end
end

getgenv().SB2RunAutoBlockForPlayer = runAutoBlockSequence

local function disconnectAll()
	for _, c in ipairs(conns) do
		pcall(function()
			c:Disconnect()
		end)
	end
	conns = {}
end

local function wireWatchers()
	disconnectAll()
	conns[#conns + 1] = Players.PlayerAdded:Connect(function(plr)
		if plr == LocalPlayer or isOwnAlt(plr) then
			return
		end
		task.defer(function()
			local waitSec = AUTO_BLOCK_WAIT
			if os.clock() < justLandedUntil then
				waitSec = 0
			end
			startAutoTimer(plr, waitSec, { silent = waitSec <= 0.05 })
		end)
	end)
	conns[#conns + 1] = Players.PlayerRemoving:Connect(function(plr)
		if not plr or plr == LocalPlayer then
			return
		end
		cancelAutoTimer(plr.UserId)
		if enabled and not autoBusy then
			setStatus('watching')
		end
	end)
	getgenv().SB2AutoBlockJoinConn = conns[1]
	getgenv().SB2AutoBlockLeaveConn = conns[2]
	getgenv().SB2AutoBlockIyReady = true
end

local function ensurePresenceWatchdog()
	if getgenv().SB2AutoBlockPresenceWatch == true then
		return
	end
	getgenv().SB2AutoBlockPresenceWatch = true
	task.spawn(function()
		while getgenv().SB2AutoBlockPresenceWatch == true do
			task.wait(PRESENCE_WATCH_SEC)
			if getgenv().SB2AutoBlockIyOwner ~= true then
				break
			end
			if not autoblockShouldRun() then
				continue
			end
			-- Recover if IY watchers were disconnected mid-session.
			if not getgenv().SB2AutoBlockJoinConn then
				pcall(wireWatchers)
			end
			if autoBusy or hopInProgress() then
				continue
			end
			local armed = 0
			local missing = 0
			for _, plr in ipairs(Players:GetPlayers()) do
				if plr ~= LocalPlayer and not isOwnAlt(plr) and not isKnownBlocked(plr) then
					if not autoTimers[plr.UserId] then
						missing += 1
						-- Strict: anyone already here with no timer gets blocked now.
						startAutoTimer(plr, 0, { silent = true })
						armed += 1
					end
				end
			end
		end
		getgenv().SB2AutoBlockPresenceWatch = false
	end)
end

setAutoBlockEnabled = function(on, silent, opts)
	opts = type(opts) == 'table' and opts or {}
	on = on == true
	autoEpoch += 1
	enabled = on
	getgenv().SB2AutoBlockWanted = on or freshFinderActive()
	if opts.userChoice == true then
		getgenv().SB2AutoBlockUserWanted = on
	end
	if opts.persist ~= false then
		writeFile(on)
	end
	if on then
		justLandedUntil = os.clock() + 8
		setStatus('watching')
		wireWatchers()
		ensurePresenceWatchdog()
		if opts.armPresent ~= false then
			armPresent(0)
			if not silent then
				say('armed (IY) — instant if someone is already here')
			end
		elseif not silent then
			say('armed (IY) — watching new joins only')
		end
	else
		cancelAllAutoTimers()
		getgenv().SB2AutoBlockHopping = nil
		writeHop({ active = false, phase = 'off' })
		setStatus('off')
		if not silent then
			say('off')
		end
	end
	-- Sync PlayerTools toggle if it exists (do not recurse into ourselves).
	pcall(function()
		local t = Toggles and Toggles.AutoBlockJoin
		if type(t) == 'table' and type(t.SetValue) == 'function' and t.Value ~= on then
			getgenv().SB2ConfigLoading = true
			t:SetValue(on)
			getgenv().SB2ConfigLoading = false
		end
	end)
	return on
end

getgenv().SB2SetAutoBlock = setAutoBlockEnabled
getgenv().SB2GetAutoBlock = function()
	return enabled == true
end
getgenv().SB2ArmAutoBlockTimers = armPresent
getgenv().SB2AutoBlockStatusFn = function()
	return statusText
end
getgenv().SB2ListFreshFinderFloors = function()
	return buildFreshFinderFloorList()
end
getgenv().SB2RefreshFreshFinderFloors = function()
	if type(getgenv().SB2EnsureServerHopCatalog) == 'function' then
		pcall(getgenv().SB2EnsureServerHopCatalog)
	end
	return buildFreshFinderFloorList()
end
getgenv().SB2SetFreshFinderFloor = function(raw)
	local ok, label = setFreshFinderFloor(raw)
	return ok, label
end
getgenv().SB2GetFreshFinderFloor = function()
	local placeId, placeName = readFreshFinderFloorPref()
	return placeId, placeName
end

getgenv().SB2StopFreshServerFinder = function(msg)
	local prev = readFreshFinder()
	local wasActive = type(prev) == 'table' and prev.active == true
	bumpFreshFinderCancel()
	writeFreshFinder({ active = false, placeId = game.PlaceId, tried = {}, hops = 0 })
	writeHop({ active = false, phase = 'off' })
	getgenv().SB2AutoBlockHopping = nil
	getgenv().SB2FreshBlockRetries = {}
	autoBusy = false
	getgenv().SB2AutoBlockBusy = false
	autoEpoch += 1
	cancelAllAutoTimers()
	-- Fresh finder wrote autoblock=true — do not leave block armed when finder stops.
	if getgenv().SB2AutoBlockUserWanted ~= true then
		enabled = false
		getgenv().SB2AutoBlockWanted = false
		writeFile(false)
		setStatus('off')
	else
		setStatus('watching')
	end
	-- Only announce when the finder was actually running (PT reloads used to spam this).
	if wasActive then
		say(msg or 'fresh server finder stopped')
	end
end

local function stopPlugin()
	disconnectAll()
	cancelAllAutoTimers()
	enabled = false
	getgenv().SB2AutoBlockPresenceWatch = false
	getgenv().SB2AutoBlockIyOwner = nil
	getgenv().SB2AutoBlockIyReady = false
	getgenv().SB2AutoBlockJoinConn = nil
	getgenv().SB2AutoBlockLeaveConn = nil
	getgenv().SB2AutoBlockBusy = false
	if getgenv().SB2SetAutoBlock == setAutoBlockEnabled then
		getgenv().SB2SetAutoBlock = nil
	end
	if getgenv().SB2ArmAutoBlockTimers == armPresent then
		getgenv().SB2ArmAutoBlockTimers = nil
	end
	getgenv()[GENV_STOP] = nil
	say('stopped')
end
getgenv()[GENV_STOP] = stopPlugin

-- Boot ASAP — do not wait for PlayerTools.
loadBlockedUserIds()
wireWatchers()
local freshFinderHopResume = false
do
	local hop = readHop()
	local pid = game.PlaceId
	if type(hop) == 'table' and hop.active == true then
		if hop.phase == 'fresh' then
			freshFinderHopResume = true
			justLandedUntil = markJustLanded(14)
			writeHop({ active = false, phase = 'off' })
			getgenv().SB2AutoBlockHopping = nil
			task.defer(resumeFreshServerFinder)
		elseif pid ~= F1_PLACE and pid ~= F11_PLACE then
			writeHop({ active = false, phase = 'off' })
			getgenv().SB2AutoBlockHopping = nil
		elseif pid == F1_PLACE or (pid == F11_PLACE and hop.phase == 'f11') then
			-- Finish / continue hop before anything else.
			justLandedUntil = os.clock() + 8
			getgenv().SB2AutoBlockHopping = true
			if pid == F1_PLACE then
				writeHop({ active = true, phase = 'f11', auto = true })
				armTeleport()
				say('IY hop — scripts ready, joining F11…')
				pcall(function()
					TeleportService:Teleport(F11_PLACE, LocalPlayer)
				end)
				-- Still arm watchers; teleport is in flight.
			elseif pid == F11_PLACE then
				writeHop({ active = false, phase = 'off' })
				getgenv().SB2AutoBlockHopping = nil
				justLandedUntil = os.clock() + 8
			end
		end
	end
end

if fileOn() then
	-- #region agent log
	agentLog('C', 'boot', 'autoblock file is true — arming from sidecar', {
		freshActive = freshFinderActive(),
		hopResume = freshFinderHopResume,
	})
	-- #endregion
	getgenv().SB2AutoBlockUserWanted = true
	setAutoBlockEnabled(true, true, { armPresent = true, userChoice = true })
	say('IY AutoBlock armed — blocking anyone already here')
else
	setStatus('off')
	say('IY AutoBlock loaded — abon or enable in PlayerTools')
end

if freshFinderActive() then
	if freshFinderHopResume then
		-- #region agent log
		agentLog('A', 'boot', 'fresh finder resuming after hop landing', {})
		-- #endregion
	else
		-- #region agent log
		agentLog('A', 'boot', 'stale fresh finder cleared on load', {
			enabled = enabled,
			fileOn = fileOn(),
		})
		-- #endregion
		if type(getgenv().SB2StopFreshServerFinder) == 'function' then
			pcall(getgenv().SB2StopFreshServerFinder, 'cleared stale fresh finder — start again from PlayerTools')
		else
			writeFreshFinder({ active = false, placeId = game.PlaceId, tried = {}, hops = 0 })
			say('cleared stale fresh server finder')
		end
	end
end
ensurePresenceWatchdog()

local Plugin = {
	['PluginName'] = 'AutoBlock',
	['PluginDescription'] = 'Early auto-block + F11 hop (loads with Infinite Yield, before PlayerTools)',
	['Commands'] = {
		['abon'] = {
			['ListName'] = 'abon / autoblockon',
			['Description'] = 'Enable auto-block (writes PlayerTools/autoblock)',
			['Aliases'] = { 'autoblockon', 'abenable' },
			['Function'] = function()
				setAutoBlockEnabled(true, false, { userChoice = true, persist = true })
			end,
		},
		['aboff'] = {
			['ListName'] = 'aboff / autoblockoff',
			['Description'] = 'Disable auto-block',
			['Aliases'] = { 'autoblockoff', 'abdisable' },
			['Function'] = function()
				setAutoBlockEnabled(false, false, { userChoice = true, persist = true })
			end,
		},
		['abstatus'] = {
			['ListName'] = 'abstatus',
			['Description'] = 'Show AutoBlock status',
			['Aliases'] = { 'abstat' },
			['Function'] = function()
				say(('enabled=%s status=%s place=%s'):format(tostring(enabled), statusText, tostring(game.PlaceId)))
			end,
		},
		['abarm'] = {
			['ListName'] = 'abarm',
			['Description'] = 'Arm timers for everyone already here (instant)',
			['Aliases'] = { 'abnow' },
			['Function'] = function()
				setAutoBlockEnabled(true, true)
				armPresent(0)
				say('armed present players')
			end,
		},
		['freshserver'] = {
			['ListName'] = 'freshserver / fsf',
			['Description'] = 'Fresh server finder — block & hop until empty',
			['Aliases'] = { 'fsf', 'freshfinder' },
			['Function'] = function(args)
				if args and args[1] then
					local ok, label = setFreshFinderFloor(table.concat(args, ' '))
					if ok then
						say('fresh finder floor → ' .. tostring(label))
					else
						say('unknown floor — try fsffloor F11')
					end
				end
				local targetPlace, targetName = readFreshFinderFloorPref()
				writeFreshFinder({
					active = true,
					placeId = targetPlace or game.PlaceId,
					placeName = targetName,
					tried = { [tostring(game.JobId or '')] = true },
					hops = 0,
					started = os.time(),
				})
				local floorLabel = targetName or tostring(targetPlace or game.PlaceId)
				say('fresh server finder started — ' .. tostring(floorLabel))
				ensureFreshFinderWatchdog()
				resumeFreshServerFinder()
			end,
		},
		['fsffloor'] = {
			['ListName'] = 'fsffloor [F11|name]',
			['Description'] = 'Set which floor fresh server finder hops on',
			['Aliases'] = { 'freshfloor', 'abfloor' },
			['Function'] = function(args)
				local raw = args and table.concat(args, ' ') or ''
				if raw == '' then
					local placeId, placeName = readFreshFinderFloorPref()
					say(('fresh finder floor: %s (%s)'):format(tostring(placeName or '?'), tostring(placeId)))
					return
				end
				local ok, label = setFreshFinderFloor(raw)
				if ok then
					say('fresh finder floor → ' .. tostring(label))
				else
					say('unknown floor — try F1, F11, Hypersiddia, etc.')
				end
			end,
		},
		['fsffloors'] = {
			['ListName'] = 'fsffloors',
			['Description'] = 'List all locations for fresh server finder',
			['Aliases'] = { 'fsflist', 'abfloors' },
			['Function'] = function()
				for _, rec in ipairs(buildFreshFinderFloorList()) do
					say(('%s (%s)'):format(tostring(rec.label or rec.name), tostring(rec.placeId)))
				end
			end,
		},
		['fsfstop'] = {
			['ListName'] = 'fsfstop',
			['Description'] = 'Stop fresh server finder',
			['Aliases'] = { 'freshstop' },
			['Function'] = function()
				getgenv().SB2StopFreshServerFinder('fresh server finder stopped')
			end,
		},
	},
}

return Plugin
